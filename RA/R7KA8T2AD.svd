                    <addressOffset>0x0513</addressOffset>
                    <size>8</size>
                    <access>read-write</access>
                    <resetValue>0x00</resetValue>
                    <resetMask>0x1f</resetMask>
                    <fields>
                        <field>
                            <name>PHYREGADDR</name>
                            <description>Address of PHY register</description>
                            <lsb>0</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PHY_DATA</name>
                    <description>PHY Data Register</description>
                    <addressOffset>0x0514</addressOffset>
                    <size>16</size>
                    <access>read-write</access>
                    <resetValue>0x0000</resetValue>
                    <resetMask>0xffff</resetMask>
                    <fields>
                        <field>
                            <name>PHYREGDATA</name>
                            <description>PHY Register Data Indication/Setting</description>
                            <lsb>0</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MII_ECAT_ACS_STAT</name>
                    <description>MII Management ECAT Access State Register</description>
                    <addressOffset>0x0516</addressOffset>
                    <size>8</size>
                    <access>read-only</access>
                    <resetValue>0x00</resetValue>
                    <resetMask>0x01</resetMask>
                    <fields>
                        <field>
                            <name>ACSMII</name>
                            <description>MII Management Interface Access Right Setting</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Enables access to the MII management interface by the PDI.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Exclusive access to the MII management interface by the ECAT</description>
                                    <value>#1</value>

                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Bit q of this register clears PTPTMEC.TEq</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>

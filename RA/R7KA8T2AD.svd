                            </enumeratedValues>
                        </field>
                        <field>
                            <name>CKEG</name>
                            <description>Clock Edge Select</description>
                            <lsb>27</lsb>
                            <msb>28</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>00</name>

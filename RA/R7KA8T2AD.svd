                                    <value>#00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>When timer match, time recovery pin is set to 0</description>
                                    <value>#01</value>
                                </enumeratedValue>
                                <enumeratedValue>

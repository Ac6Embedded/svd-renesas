                                    <description>Disables to use the counter clear by GTIOC input as the clear factor for other channels</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Enables to use the counter clear by GTIOC input as the clear factor for other channels</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>SSCGRP</name>
                            <description>Synchronous Set/Clear Group Select</description>

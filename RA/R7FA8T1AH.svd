                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>ECER2F</name>
                            <description>Flag bit of 2bits ECC error detection</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>EC1EDIC</name>
                            <description>Control bit of interrupt at ECC 1bit error detection</description>

                                    <value>#000</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>001</name>
                                    <description>1 wait (48MHz &lt; ICLK &lt;= 96MHz)</description>
                                    <value>#001</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>010</name>
                                    <description>2 waits (96MHz &lt; ICLK &lt;= 144MHz)</description>
                                    <value>#010</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>011</name>
                                    <description>3 waits (144Hz &lt; ICLK &lt;= 192MHz)</description>
                                    <value>#011</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>100</name>
                                    <description>4 waits (192Hz &lt; ICLK &lt;= 240MHz)</description>
                                    <value>#100</value>
                                </enumeratedValue>

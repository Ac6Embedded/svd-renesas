                                    <description>-: No mode fault error or underrun error</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>10</name>
                                    <description>Mode fault error occurred</description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>Underrun error occurred</description>
                                    <value>#11</value>
                                </enumeratedValue>

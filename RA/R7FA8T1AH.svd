                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Enables the SD host interface to receive SDIO interrupt from the SDIO card</description>
                                    <value>#1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Disables the SD host interface to receive SDIO interrupt from the SDIO card</description>
                                    <value>#0</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>

                                    <name>0</name>
                                    <description>Invalid</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Transmits the setup packet.</description>
                                    <value>#1</value>
                                </enumeratedValue>

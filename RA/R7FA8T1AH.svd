                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>An error has occured in the command index of the response to a command issued within a command sequence.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>

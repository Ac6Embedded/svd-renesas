                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>011</name>
                                    <description>Running: Waiting for receive packet</description>
                                    <value>#011</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>100</name>
                                    <description>Suspended: Receive Descriptor Unavailable</description>

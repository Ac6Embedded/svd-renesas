                                    <name>1</name>
                                    <description>DMA transfer is enabled. (The EN bit in the CHSTAT_n register is set) </description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>CLREN</name>
                            <description>Clear Enable</description>
                            <lsb>1</lsb>
                            <msb>1</msb>

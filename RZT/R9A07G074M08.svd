                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>101</name>
                                    <description>Running: Closing Receive Descriptor</description>
                                    <value>#101</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>110</name>

                                    <description>Next-access delay is 1 RSPCK + 5 PCLKSPIn</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Next-access delay is the set value of the SPI next-access delay register (SPND).</description>
                                    <value>#1</value>
                                </enumeratedValue>

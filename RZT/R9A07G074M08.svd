                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>An acknowledgment was received from the Slave for the initialization of a message.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>

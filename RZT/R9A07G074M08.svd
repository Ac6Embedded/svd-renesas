                            <lsb>2</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0x0</name>
                                    <description>The frequency of the CSR clock is 60-100 MHz, and the MDC clock is CSR clock/42.</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x1</name>
                                    <description>The frequency of the CSR clock is 100-150 MHz, and the MDC clock is CSR clock/62.</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x2</name>
                                    <description>The frequency of the CSR clock is 20-35 MHz, and the MDC clock is CSR clock/16.</description>
                                    <value>0x2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x3</name>
                                    <description>The frequency of the CSR clock is 35-60 MHz, and the MDC clock is CSR clock/26.</description>
                                    <value>0x3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x4</name>
                                    <description>The frequency of the CSR clock is 150-250 MHz, and the MDC clock is CSR clock/102.</description>
                                    <value>0x4</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x5</name>
                                    <description>The frequency of the CSR clock is 250-300 MHz, and the MDC clock is CSR clock/124.</description>
                                    <value>0x5</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x6</name>
                                    <description>Reserved</description>
                                    <value>0x6</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x7</name>
                                    <description>Reserved</description>
                                    <value>0x7</value>
                                </enumeratedValue>
                            </enumeratedValues>

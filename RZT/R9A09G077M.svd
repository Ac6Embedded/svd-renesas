                                    <name>0</name>
                                    <description>No acknowledgment for the initialization received.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>An acknowledgment was received from the Slave for the initialization of a message.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MASK_H</name>

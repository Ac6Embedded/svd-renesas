                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The value of the ECERDB[6:0] bits in the Wn_EC710TRC register is output</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>

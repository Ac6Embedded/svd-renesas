                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>100</name>
                                    <description>4 IIC Phi cycles (When ICMR2.DLCS = 0 (IIC Phi)) 7 or 8 IIC Phi cycles (When ICMR2.DLCS = 1 (IIC Phi/2)) </description>

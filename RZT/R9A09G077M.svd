                                    <description>All DSL Slave events are cleared.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The DSL Slave has signaled an event and the summary mask is set accordingly.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>

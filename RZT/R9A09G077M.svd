                <register>
                    <name>MMCTL_OUT_CT</name>
                    <description>Cut-Through Register</description>
                    <addressOffset>0x3B00</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00070007</resetMask>
                    <fields>
                        <field>
                            <name>CT_OVR_ENA</name>
                            <description>Per-port bit mask to enable overriding the Cut-Through (CT) behavior of the output ports with CT_OVR. When set to 0, the frames are transmitted CT if the CT flag of the frame context is set.</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CT_OVR</name>
                            <description>1 bit per-port value to set the Cut Through behavior of the output ports. When set to 0, all frames are sent as Store &amp; Forward (SF) frames. When set to 1, frames with the CT flag set in the frame context are started as soon as the frame context information is available.</description>
                            <lsb>16</lsb>
                            <msb>18</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_CTFL_P0_3_ENA</name>
                    <description>Cut-Through Frame Length Enable Register</description>
                    <addressOffset>0x3B04</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00ffffff</resetValue>
                    <resetMask>0x00ffffff</resetMask>
                    <fields>
                        <field>
                            <name>CTFL_P0_ENA</name>
                            <description>Port 0 bit mask of n bits, where n is the number of queues per port indicating whether the CTFL is used for Cut-Through (CT) frames. When set to 1, a CT frame requires a CTFL entry to be written as a CT frame in the output memory.</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CTFL_P1_ENA</name>
                            <description>Port 1 bit mask of n bits, where n is the number of queues per port indicating whether the CTFL is used for Cut-Through (CT) frames. When set to 1, a CT frame requires a CTFL entry to be written as a CT frame in the output memory.</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CTFL_P2_ENA</name>
                            <description>Port 2 bit mask of n bits, where n is the number of queues per port indicating whether the CTFL is used for Cut-Through (CT) frames. When set to 1, a CT frame requires a CTFL entry to be written as a CT frame in the output memory.</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>3</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-2</dimIndex>
                    <name>MMCTL_YELLOW_BYTE_LENGTH_P%s</name>
                    <description>Port %s Yellow Period Byte Length Register</description>
                    <addressOffset>0x3B20</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x000005ec</resetValue>
                    <resetMask>0x0001fffc</resetMask>
                    <fields>
                        <field>
                            <name>YELLOW_LEN</name>
                            <description>Length in bytes of the YELLOW period for port n. Determines whether a frame can be transmitted before the YELLOW period expires. The value is programmed in increments of 4 bytes excluding the MAC overhead (IPG, Preamble and FCS if appended) of the frame.</description>
                            <lsb>2</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>YLEN_EN</name>
                            <description>When set to 1, enables transmission when OUT_CT_ENA is low only if the frame length is less than YELLOW_LEN. If cleared, YELLOW_LEN is ignored and frames are always transmitted in SF mode when OUT_CT_ENA is 0.</description>
                            <lsb>16</lsb>
                            <msb>16</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>

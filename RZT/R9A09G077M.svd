                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The value of the Wn_EC710TED register is selected</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>ECREOS</name>
                            <description>ECC Redundancy Bit Output Data Select</description>

                    <resetMask>0xa6c00fff</resetMask>
                    <fields>
                        <field>
                            <name>address</name>
                            <description>Memory Address for Read and Write Transactions</description>
                            <lsb>0</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CLEAR_DYNAMIC</name>
                            <description>When set to 1, scan the complete table for valid dynamic history entries and deletes them (writes entry with all 0s).</description>
                            <lsb>22</lsb>
                            <msb>22</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CLEAR_MEMORY</name>
                            <description>When set to 1, write all memory locations with 0.</description>
                            <lsb>23</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>WRITE</name>
                            <description>When set to 1, perform a Single Write Transaction.</description>
                            <lsb>25</lsb>
                            <msb>25</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>READ</name>
                            <description>When set to 1, perform Single Read Transaction.</description>
                            <lsb>26</lsb>
                            <msb>26</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CLEAR</name>
                            <description>When set to 1, write all 0s to the entry selected by the given address.</description>
                            <lsb>29</lsb>
                            <msb>29</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>BUSY</name>
                            <description>Transaction Busy Indication</description>
                            <lsb>31</lsb>
                            <msb>31</msb>
                            <access>read-only</access>
                        </field>
                    </fields>

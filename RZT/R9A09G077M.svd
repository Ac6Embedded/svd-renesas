                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>bec_tmr1_IRQ_pending</name>
                            <description>Beacon Timeout Timer Expire Event for Port 1</description>
                            <lsb>5</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>supr_chng_IRQ_pending</name>
                            <description>Latched Supervisor Change Event</description>
                            <lsb>6</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>Link0_IRQ_pending</name>
                            <description>Latched Link Status Change Event for Port 0</description>
                            <lsb>7</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>Link1_IRQ_pending</name>

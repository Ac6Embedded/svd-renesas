                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>CntAcceptB</name>
                    <description>PRP Valid Frame LAN-B Count Register</description>
                    <addressOffset>0x3D58</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>CntAcceptB</name>
                            <description>Valid frames received on LAN B which had a valid sequence number in the expected range.</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>CntMissing</name>
                    <description>PRP Drop History Adjustment Count</description>
                    <addressOffset>0x3D5C</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>CntMissing</name>
                            <description>Indicates adjustment of the drop history as a frame was received with a sequence number of expected + history + 1. This occurs if the same frame was dropped in both LAN segments (one sequence number is missing) and the history is now extended beyond that sequence number (causing it to be treated as drop allowed).</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HUB_CONFIG</name>
                    <description>HUB Configuration Register</description>
                    <addressOffset>0x3E00</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000180</resetValue>
                    <resetMask>0x00000fdf</resetMask>
                    <fields>
                        <field>
                            <name>HUB_ENA</name>
                            <description>Enable Integrated HUB Operation</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RETRANSMIT_ENA</name>
                            <description>Enable Hub Retransmit Capability</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TRIGGER_MODE</name>
                            <description>Enable Single Frame Trigger Mode</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>HUB_ISOLATE</name>
                            <description>Isolate all hub ports from the other ports of the switch and allow communication with management port only. It is then up to the application of the management port to implement some bridging functionality to other ports as required.</description>
                            <lsb>3</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TIMER_SEL</name>
                            <description>Select the timer to use for timed triggers</description>
                            <lsb>4</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Timer 0</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Timer 1</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>IPG_WAIT</name>
                            <lsb>6</lsb>
                            <msb>8</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CRS_GEN</name>
                            <lsb>9</lsb>
                            <msb>9</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRMB_GEN_DIS</name>
                            <lsb>10</lsb>
                            <msb>10</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>JAM_WAIT_IDLE</name>
                            <lsb>11</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HUB_GROUP</name>
                    <description>HUB Port Group Register</description>
                    <addressOffset>0x3E04</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000007</resetMask>
                    <fields>
                        <field>
                            <name>HUB_GROUP</name>
                            <description>Define all ports that should be combined to a Hub Group.</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HUB_DEFPORT</name>
                    <description>HUB Default Port Selection Register</description>
                    <addressOffset>0x3E08</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000007</resetMask>
                    <fields>
                        <field>
                            <name>HUB_DEFPORT</name>
                            <description>The default port within the Hub Group where all traffic from a port outside the group is forwarded to port (bit 0 = port 0, bit 1 = port 1, and bit 2 = port 2). If a frame should be forwarded to any of the hub ports, the frame is sent to this port only. The copy function of the hub copies it to all PHY interfaces of the group eventually.</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HUB_TRIGGER_IMMEDIATE</name>
                    <description>HUB Transmission Trigger Immediate Register</description>
                    <addressOffset>0x3E0C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000007</resetMask>
                    <fields>
                        <field>
                            <name>HUB_TRIGGER_IMMEDIATE</name>
                            <description>Trigger immediate transmission of a single frame from given port within the hub group (bit 0 = port 0, bit 1 = port 1, and bit 2 = port 2).</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HUB_TRIGGER_AT</name>
                    <description>HUB Transmission Trigger At Register</description>
                    <addressOffset>0x3E10</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000007</resetMask>
                    <fields>
                        <field>
                            <name>HUB_TRIGGER_AT</name>
                            <description>Trigger Transmission of a Single Frame at a Specific Time (bit 0 = port 0, bit 1 = port 1, and bit 2 = port 2).</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HUB_TTIME</name>
                    <description>HUB Transmission Time Define Register</description>
                    <addressOffset>0x3E14</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>HUB_TTIME</name>
                            <description>Define the Time Value when a Trigger Should Occur</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HUB_IRQ_CONTROL</name>
                    <description>HUB Interrupt Control Register</description>
                    <addressOffset>0x3E18</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000003f</resetMask>
                    <fields>
                        <field>
                            <name>RX_TRIGGER</name>
                            <description>Enable Interrupt on Receive Pattern Match Trigger Function</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CHANGE_DET</name>
                            <description>Enable interrupt for hub TX state machine port state change request detection</description>
                            <lsb>3</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TRIGGER_IMMEDIATE</name>
                            <description>Enable interrupt when hub transmit started after writing the HUB_TRIGGER_IMMEDIATE register</description>
                            <lsb>4</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TRIGGER_TIMER</name>
                            <description>Enable interrupt when hub transmit started after writing the HUB_TRIGGER_TIME register and the timeout value is reached (register HUB_TTIME).</description>
                            <lsb>5</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HUB_IRQ_STAT_ACK</name>
                    <description>HUB Interrupt Status/ACK Register</description>
                    <addressOffset>0x3E1C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000003f</resetMask>
                    <fields>
                        <field>
                            <name>RX_TRIGGER</name>
                            <description>Interrupt Pending Indication</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CHANGE_DET</name>
                            <description>This bit functions the same as RX_TRIGGER bit.</description>
                            <lsb>3</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TRIGGER_IMMEDIATE</name>
                            <description>This bit functions the same as RX_TRIGGER bit.</description>
                            <lsb>4</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TRIGGER_TIMER</name>
                            <description>This bit functions the same as RX_TRIGGER bit.</description>
                            <lsb>5</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HUB_STATUS</name>
                    <description>HUB Status Register</description>
                    <addressOffset>0x3E20</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00001e07</resetMask>
                    <fields>
                        <field>
                            <name>PORTS_ACTIVE</name>
                            <description>When this bit is 1, it shows the currently active ports of the Hub group which are allowed for transmit.</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>TX_ACTIVE</name>
                            <description>When this bit is 1, the hub global transmit state machine has successfully entered Hub mode and is now controlling the hub group.</description>
                            <lsb>9</lsb>
                            <msb>9</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>TX_BUSY</name>
                            <description>When this bit is 1, the local device currently transmits data to all ports within the hub group.</description>
                            <lsb>10</lsb>
                            <msb>10</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>Speed_OK</name>
                            <description>When this bit is 1, it indicates that the port speed of all group ports match.</description>
                            <lsb>11</lsb>
                            <msb>11</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>TX_Change_Pending</name>
                            <description>Indicate a pending change request in the hub transmitter that is unsolved and cause the hub to stop operation (no longer performing any transmissions).</description>
                            <lsb>12</lsb>
                            <msb>12</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HUB_OPORT_STATUS</name>
                    <description>HUB Output Port Status Register</description>
                    <addressOffset>0x3E24</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000007</resetMask>
                    <fields>
                        <field>
                            <name>HUB_OPORT_STATUS</name>
                            <description>Per Output Port Data Available Status</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_CONFIG</name>
                    <description>TDMA Configuration Register</description>
                    <addressOffset>0x3E80</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x0f0f0000</resetValue>
                    <resetMask>0x0f0f13f7</resetMask>
                    <fields>
                        <field>
                            <name>TDMA_ENA</name>
                            <description>Enable TDMA Scheduler</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>WAIT_START</name>
                            <description>Status bit which is set as long as the scheduler is enabled but has not yet reached the time given in register TDMA_START.</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>TIMER_SEL</name>
                            <description>Select which timer to use as the time source for the scheduler</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Timer 0</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Timer 1</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>RED_PERIOD</name>
                            <description>Read only bit indicating the current period for Profinet</description>
                            <lsb>4</lsb>
                            <msb>4</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>RED_OVRD_ENA</name>
                            <description>Enables overriding the RED period status, regardless of the indication by the TCV.</description>
                            <lsb>5</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RED_OVRD</name>
                            <description>Override Value for the RED Period</description>
                            <lsb>6</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IN_CT_WREN</name>
                            <lsb>7</lsb>
                            <msb>7</msb>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>OUT_CT_WREN</name>
                            <description>Enable writing the OUT_CT_ENA control to the egress ports.</description>
                            <lsb>8</lsb>
                            <msb>8</msb>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>HOLD_REQ_CLR</name>
                            <description>Writing 1 to this register clears the state of TDMA hold request.</description>
                            <lsb>9</lsb>
                            <msb>9</msb>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>TIMER_SEL_ACTIVE</name>
                            <description>Return the current timer being used for the TDMA Scheduler</description>
                            <lsb>12</lsb>
                            <msb>12</msb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Timer 0</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Timer 1</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>IN_CT_ENA</name>
                            <description>On read, return the current status of the ingress Cut-Through enable indicated by the TDMA scheduler. On write, override the ingress Cut-Through enable if IN_CT_WREN is also 1.</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OUT_CT_ENA</name>
                            <description>On read, return the current status of the egress Cut-Through enable indicated by the TDMA scheduler. On write, override the egress Cut-Through enable if OUT_CT_WREN is also 1.</description>
                            <lsb>24</lsb>
                            <msb>27</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_ENA_CTRL</name>
                    <description>TDMA Scheduling Enable Control Register</description>
                    <addressOffset>0x3E84</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffff000f</resetMask>
                    <fields>
                        <field>
                            <name>PORT_ENA</name>
                            <description>Set to 1 to indicate that a port is operating in TDMA mode. When set to 1 for a port, the port does not prefetch another frame until the current frame in progress is done and if TDMA_PREBUF_DIS in COMMAND_CONFIG is set to 1. This helps adding precision to the queue gating operations indicated by the TDMA at the expense of loss of line rate.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>QGATE_DIS</name>
                            <description>One bit per output queue. When a bit is set to 1, the TDMA scheduler gating commands do not affect the queue even if the queue mask in the TCV control data is set to 1.</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>QTRIG_DIS</name>
                            <description>One bit per output queue. When a bit is set to 1, the TDMA scheduler triggering commands do not affect the queue even if the queue mask in the TCV control data is set to 1.</description>
                            <lsb>24</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_START</name>
                    <description>TDMA Start Time Set Register</description>
                    <addressOffset>0x3E88</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>TDMA_START</name>
                            <description>Set the start time for the very first cycle after system initialization has completed. The value is compared with the system time (selected in TDMA_CONFIG.TIMER_SEL) and when it is reached (crossed), the scheduler begins with its first cycle. The 2nd cycle is then at TDMA_START + TDMA_CYCLE.</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_MODULO</name>
                    <description>TDMA System Timer Modulo</description>
                    <addressOffset>0x3E8C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>TDMA_MODULO</name>
                            <description>The System Timer Modulo</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_CYCLE</name>
                    <description>TDMA Periodic Cycle Set Register</description>
                    <addressOffset>0x3E90</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>TDMA_CYCLE</name>
                            <description>The periodic cycle time for the scheduler given in system timer time.</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TCV_SEQ_ADDR</name>
                    <description>TCV Sequence Address Register</description>
                    <addressOffset>0x3E94</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x80000fff</resetMask>
                    <fields>
                        <field>
                            <name>TCV_S_ADDR</name>
                            <description>Address to write to or read from in the TCV sequence table.</description>
                            <lsb>0</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>ADDR_AINC</name>
                            <description>When set to 1, read and write operations performed using TCV_SEQ_CTRL causes the address in TCV_S_ADDR to auto-increment after the operation.</description>
                            <lsb>31</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TCV_SEQ_CTRL</name>
                    <description>TCV Sequence Table Control Register</description>
                    <addressOffset>0x3E98</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xbfc007ff</resetMask>
                    <fields>
                        <field>
                            <name>START</name>
                            <description>Indicate this TCV must be executed after the next cycle start</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>INT</name>
                            <description>Indicates this TCV generates an interrupt to the CPU when activated</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TCV_D_IDX</name>
                            <description>Index to the TCV Data Entry</description>
                            <lsb>2</lsb>
                            <msb>10</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>GPIO</name>
                            <description>Generic bits that control the output pins ETHSW_TDMAOUTn (n = 0 to 7)</description>
                            <lsb>22</lsb>
                            <msb>29</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>READ_MODE</name>
                            <description>When set to 1, a read operation is performed instead of writing to the TCV sequence table. The read data (START, INT, TCV_D_IDX[8:0], and GPIO) can be obtained by reading this register afterwards. On read, this field always returns 0.</description>
                            <lsb>31</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TCV_SEQ_LAST</name>
                    <description>TCV Sequence Last Entry</description>
                    <addressOffset>0x3E9C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0fff0fff</resetMask>
                    <fields>
                        <field>
                            <name>LAST</name>
                            <description>Defines the last entry to read from the TCV sequence table when the TDMA scheduler is operating.</description>
                            <lsb>0</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>ACTIVE</name>
                            <description>Return the active TCV sequence entry.</description>
                            <lsb>16</lsb>
                            <msb>27</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TCV_D_ADDR</name>
                    <description>TCV Data Address Register</description>
                    <addressOffset>0x3EA0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x800001ff</resetMask>
                    <fields>
                        <field>
                            <name>ADDR</name>
                            <description>Address to read from/write to in the TCV data table</description>
                            <lsb>0</lsb>
                            <msb>8</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>AINC_WR_ENA</name>
                            <description>Auto-Increment Enable</description>
                            <lsb>31</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TCV_D_OFFSET</name>
                    <description>TCV Data Offset Register</description>
                    <addressOffset>0x3EA4</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>TCV_D_OFFSET</name>
                            <description>32-bit time offset for the TCV data entry indicated by TCV_D_ADDR. When accessing the table, TCV_D_OFFSET must be read or written before TCV_D_CTRL.</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TCV_D_CTRL</name>
                    <description>TCV Data Control Register</description>
                    <addressOffset>0x3EA8</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000fffff</resetMask>
                    <fields>
                        <field>
                            <name>INC_CTR0</name>
                            <description>Increment Control for Counter 0</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>INC_CTR1</name>
                            <description>Increment Control for Counter 1</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RED_PERIOD</name>
                            <description>Period Color Control (for Profinet IRT)</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OUT_CT_ENA</name>
                            <description>Output Cut-Through Enable</description>
                            <lsb>3</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IN_CT_ENA</name>
                            <description>Input Cut-Through Enable</description>
                            <lsb>4</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TRIGGER_MODE</name>
                            <description>Trigger mode enable when set to 1. GATE_MODE must be 0, otherwise, GATE_MODE has precedence.</description>
                            <lsb>5</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>GATE_MODE</name>
                            <description>Gate mode enable when set to 1.</description>
                            <lsb>6</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>HOLD_REQ</name>
                            <description>Preemption hold request. Generates a hold request to ports enabled in PMASK.</description>
                            <lsb>7</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>QGATE</name>
                            <description>Bits mask, one per output queue</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PMASK</name>
                            <description>Bits mask, one per output port</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_CTR0</name>
                    <description>TDMA Counter 0</description>
                    <addressOffset>0x3EAC</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>TDMA_CTR0</name>
                            <description>32-bit counter that is incremented when the TCV field INC_CTR0 is set to 1.</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_CTR1</name>
                    <description>TDMA Counter 1</description>
                    <addressOffset>0x3EB0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffff01ff</resetMask>
                    <fields>
                        <field>
                            <name>VALUE</name>
                            <description>Current Counter Value</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>WRITE_ENA</name>
                            <description>Write Enable for VALUE</description>
                            <lsb>8</lsb>
                            <msb>8</msb>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>MAX</name>
                            <description>Counter Maximum Value</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>INT_VALUE</name>
                            <description>Interrupt Value</description>
                            <lsb>24</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_TCV_START</name>
                    <description>TDMA TCV Sequence Entry Start</description>
                    <addressOffset>0x3EB4</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000fff</resetMask>
                    <fields>
                        <field>
                            <name>TDMA_TCV_START</name>
                            <description>Define the TCV_SEQ entry to start from.</description>
                            <lsb>0</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TIME_LOAD_NEXT</name>
                    <description>TDMA Calculated Next Loading Time</description>
                    <addressOffset>0x3EB8</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>TIME_LOAD_NEXT</name>
                            <description>Status giving the calculated time the scheduler loads into its internal compare register after the current running slot end is reached (not the end of the current slot).</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_IRQ_CONTROL</name>
                    <description>TDMA IRQ Control Register</description>
                    <addressOffset>0x3EBC</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00002001</resetMask>
                    <fields>
                        <field>
                            <name>TCV_INT_EN</name>
                            <description>Enable Interrupts Generated by the TCV</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CTR1_INT_EN</name>
                            <description>Enable Interrupts Generated from Counter 1</description>
                            <lsb>13</lsb>
                            <msb>13</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_IRQ_STAT_ACK</name>
                    <description>TDMA IRQ Status/ACK Register</description>
                    <addressOffset>0x3EC0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00002001</resetMask>
                    <fields>
                        <field>
                            <name>TCV_ACK</name>
                            <description>TCV Execution Event</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CTR1_ACK</name>
                            <description>Counter 1 Event</description>
                            <lsb>13</lsb>
                            <msb>13</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TDMA_GPIO</name>
                    <description>TDMA GPIO Register</description>
                    <addressOffset>0x3EC4</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffff00ff</resetMask>
                    <fields>
                        <field>
                            <name>GPIO_STATUS</name>
                            <description>Status of the GPIO Output Pins</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>GPIO_MODE</name>
                            <description>2 bits per GPIO pin to configure its operating mode</description>
                            <lsb>16</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-3</dimIndex>
                    <name>RXMATCH_CONFIG%s</name>
                    <description>RX Pattern Matcher Configuration for Port %s</description>
                    <addressOffset>0x3F00</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00000fff</resetMask>
                    <fields>
                        <field>
                            <name>PATTERN_EN</name>
                            <description>Enable Patterns on the Port (RX)</description>
                            <lsb>0</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>12</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-11</dimIndex>
                    <name>PATTERN_CTRL%s</name>
                    <description>RX Pattern Matcher Function Control for Pattern %s</description>
                    <addressOffset>0x3F40</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xf7cfffff</resetMask>
                    <fields>
                        <field>
                            <name>MATCH_NOT</name>
                            <description>When set, a match is reported and the functions of this control are executed if the pattern does not match.</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MGMTFWD</name>
                            <description>When set, the frame is forwarded to the management port only (suppressing destination address lookup).</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>DISCARD</name>
                            <description>When set, the frame is discarded.</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SET_PRIO</name>
                            <description>Set frame priority, overriding normal classification.</description>
                            <lsb>3</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MODE</name>
                            <description>Selects the operating mode</description>
                            <lsb>4</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>00</name>
                                    <description>Mode 1: Fixed 12-byte match</description>
                                    <value>#00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>Mode 2: 2-byte table lookup</description>
                                    <value>#01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>10</name>
                                    <description>Mode 3: 2-byte range match at set offset</description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>Mode 4: 2-byte range not-match at set offset</description>
                                    <value>#11</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>TIMER_SEL_OVR</name>
                            <description>Overrides the default timer to use by timestamp operations when set to 1, using instead the value in TIMER_SEL.</description>
                            <lsb>6</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>FORCE_FORWARD</name>
                            <description>When set, the frame is forwarded to the ports indicated in PORTMASK, ignoring the result from L2 lookups.</description>
                            <lsb>7</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>HUBTRIGGER</name>
                            <description>When set, the port defined in the PORTMASK setting is allowed for transmitting one frame.</description>
                            <lsb>8</lsb>
                            <msb>8</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MATCH_RED</name>
                            <description>Enable the pattern matcher only when the TDMA indicates that this is the RED period.</description>
                            <lsb>9</lsb>
                            <msb>9</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MATCH_NOT_RED</name>
                            <description>Enable the pattern matcher only when the TDMA indicates that this is not the RED period.</description>
                            <lsb>10</lsb>
                            <msb>10</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VLAN_SKIP</name>
                            <description>When set to 1, for operating modes 1, 2, and 3. The first Length/Type after the MAC source address is compared against 0x8100. If it matches, a VLAN tag is assumed and 4 bytes are skipped.</description>
                            <lsb>11</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRIORITY</name>
                            <description>Priority of the frame used when SET_PRIO is set. The priority is used to forward the frame into the corresponding output queue of a port.</description>
                            <lsb>12</lsb>
                            <msb>14</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>LEARNING_DIS</name>
                            <description>When set to 1, the hardware learning function is not executed.</description>
                            <lsb>15</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PORTMASK</name>
                            <description>A port mask used depending on the control bits (for example, HUBTRIGGER).</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IMC_TRIGGER</name>
                            <description>When set, the ports defined in the PORTMASK setting are allowed for transmitting one frame from the queues indicated by QUEUESEL. The trigger request is sent to the integrated memory controller.</description>
                            <lsb>22</lsb>
                            <msb>22</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IMC_TRIGGER_DLY</name>
                            <description>When set, the ports defined in the PORTMASK setting are allowed for transmitting one frame from the queues indicated by QUEUESEL. The trigger request is sent to the integrated memory controller and the event is delayed by the value programmed in MMCTL_DLY_QTRIGGER_CTRL.</description>
                            <lsb>23</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SWAP_BYTES</name>
                            <description>Applicable only for operating modes 1, 2, and 3. When set to 1, the byte order is swapped from the order received by the frame. When set to 0, the first byte received by the frame is set into position 0 for comparison. When set to 1, the first byte received is set into position 3 (for mode 1) or position 2 (for mode 2 and 3) for comparison.</description>
                            <lsb>24</lsb>
                            <msb>24</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MATCH_LT</name>
                            <description>For operating modes 1, 2, and 3. When set to 1, the Length/Type field in the frame after the MAC source address is compared against the value in length_type in the compare register. If VLAN_SKIP is set and the frame has a VLAN tag with Length/Type of 0x8100 then the comparison is performed in the Length/Type following the VLAN tag.</description>
                            <lsb>25</lsb>
                            <msb>25</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TIMER_SEL</name>
                            <description>Override value to use when TIMER_SEL_OVR is set to 1 for selecting the timer for this frame.</description>
                            <lsb>26</lsb>
                            <msb>26</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Timer 0</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Timer 1</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>QUEUESEL</name>
                            <description>A queue selector for the HUBTRIGGER function. Selects the queue to trigger a frame, or sets from 0x8 to 0xF to select one among all queues.</description>
                            <lsb>28</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PATTERN_IRQ_CONTROL</name>
                    <description>RX Pattern Matcher Interrupt Control Register</description>
                    <addressOffset>0x3F80</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000f0fff</resetMask>
                    <fields>
                        <field>
                            <name>MATCHINT</name>
                            <description>Enable Interrupt on Receive Pattern Match</description>
                            <lsb>0</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>ERROR_INT</name>
                            <description>Enable Interrupt on Internal Pattern Matcher Error</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PATTERN_IRQ_STAT_ACK</name>
                    <description>RX Pattern Matcher Interrupt Status/ACK Register</description>
                    <addressOffset>0x3F84</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000f0fff</resetMask>
                    <fields>
                        <field>
                            <name>MATCHINT</name>
                            <description>Interrupt pending indication for the corresponding pattern match events (see ).</description>
                            <lsb>0</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>ERROR_INT</name>
                            <description>Interrupt pending indication for a pattern matcher error, per port.</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PTRN_VLANID</name>
                    <description>Custom VLAN ID Register</description>
                    <addressOffset>0x3F88</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00008100</resetValue>
                    <resetMask>0x0000ffff</resetMask>
                    <fields>
                        <field>
                            <name>PTRN_VLANID</name>
                            <description>Custom VLAN ID to use. The default VLAN ID 0x8100 is always considered by the hardware. This value can be changed to detect other VLANs like 0x8808.</description>
                            <lsb>0</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PATTERN_SEL</name>
                    <description>RX Pattern Number Selection Register</description>
                    <addressOffset>0x3F8C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000000f</resetMask>
                    <fields>
                        <field>
                            <name>PATTERN_SEL</name>
                            <description>Define the pattern number which is selected for read/write through the PTRN_CMP_* and PTRN_MSK_* registers.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PTRN_CMP_30</name>
                    <description>Pattern Compare Value Bytes 3 .. 0</description>
                    <addressOffset>0x3FC0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>PTRN_CMP_30</name>
                            <description>Pattern Compare Value Bytes 3 .. 0</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PTRN_CMP_74</name>
                    <description>Pattern Compare Value Bytes 7 .. 4</description>
                    <addressOffset>0x3FC4</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>PTRN_CMP_74</name>
                            <description>Pattern Compare Value Bytes 7 .. 4</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PTRN_CMP_118</name>
                    <description>Pattern Compare Value Bytes 11 .. 8</description>
                    <addressOffset>0x3FC8</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>PTRN_CMP_118</name>
                            <description>Pattern Compare Value Bytes 11 .. 8</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>

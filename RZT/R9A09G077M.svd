                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>EDST</name>
                            <description>Egress Destination MAC Address for Mirror Filtering</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MIRROR_EDST_1</name>
                    <description>Egress Destination MAC Address for Mirror Filtering Register 1</description>
                    <addressOffset>0x68</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000ffff</resetMask>
                    <fields>
                        <field>
                            <name>EDST</name>
                            <description>Egress Destination MAC Address for Mirror Filtering</description>
                            <lsb>0</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MIRROR_CNT</name>
                    <description>Mirror Filtering Count Value Register</description>
                    <addressOffset>0x6C</addressOffset>

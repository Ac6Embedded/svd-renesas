                            <access>read-write</access>
                        </field>
                        <field>
                            <name>invalid_tmr_IRQ_pending</name>
                            <description>Latched Event on Invalid Beacon Timeout Timer Value Detection Within Beacon Frame on Port 0 or Port 1</description>
                            <lsb>11</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>bec_rcv0_IRQ_pending</name>
                            <description>Latched Event on Beacon Frame Detection on Port 0</description>
                            <lsb>12</lsb>
                            <msb>12</msb>
                            <access>read-write</access>

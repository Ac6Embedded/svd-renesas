                                    <description>Interrupt output on the low level</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Interrupt output on the high level</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>

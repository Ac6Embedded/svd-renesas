                                    <description>No effect</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Masks a DMA transfer request from the USB control</description>
                                    <value>#1</value>
                                </enumeratedValue>

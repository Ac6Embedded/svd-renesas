                    <resetMask>0x00ffffff</resetMask>
                    <fields>
                        <field>
                            <name>IALK_ID_MIN</name>
                            <description>Minimum value for the 24-bit ID in the MAC address</description>
                            <lsb>0</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>

                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The queue uses the pool programmed in Q7_MAP</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_QGATE</name>
                    <description>Queue Gate State Register</description>
                    <addressOffset>0x3B6C</addressOffset>
                    <size>32</size>
                    <access>write-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffff000f</resetMask>
                    <fields>
                        <field>
                            <name>PORT_MASK</name>
                            <description>Per-port bit mask. When set to 1 for a port, the queue gate state is changed for that port as indicated by QUEUE_GATE.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>QUEUE_GATE</name>
                            <description>2-bit per queue indicating the action to be performed on each queue of the ports indicated by PORT_MASK.</description>
                            <lsb>16</lsb>
                            <msb>31</msb>
                            <access>write-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>00</name>
                                    <description>Hold state, does not change the queue gate state</description>
                                    <value>#00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>Toggle state, toggles the gate state</description>
                                    <value>#01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>10</name>
                                    <description>Gate queue, closes the queue</description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>Open queue, enables the queue</description>
                                    <value>#11</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_QTRIG</name>
                    <description>Queue Trigger Register</description>
                    <addressOffset>0x3B70</addressOffset>
                    <size>32</size>
                    <access>write-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00ff000f</resetMask>
                    <fields>
                        <field>
                            <name>PORT_MASK</name>
                            <description>Per-port bit mask. When set to 1 for a port, a frame is triggered from the closed queues indicated by QUEUE_TRIG.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>QUEUE_TRIG</name>
                            <description>1-bit per queue indicating from which queues a frame is to be transmitted from the ports indicated by PORT_MASK. When set to 1, a single frame is transmitted per indicated port in PORT_MASK among the queues indicated by QUEUE_TRIG.</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>write-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_QFLUSH</name>
                    <description>Flush Event Select Register</description>
                    <addressOffset>0x3B74</addressOffset>
                    <size>32</size>
                    <access>write-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x03ff000f</resetMask>
                    <fields>
                        <field>
                            <name>PORT_MASK</name>
                            <description>Per-port bit mask. When set to 1 for a port, the queue flush status is changed for that port for the queues indicated in QUEUE_MASK.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>QUEUE_MASK</name>
                            <description>1 bit per queue indicating for which queues of the ports indicated by PORT_MASK the flush state is changed as indicated in ACTION.</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>ACTION</name>
                            <description>Selects the flush state for the queues indicated by QUEUE_MASK in the ports indicated by PORT_MASK. Possible actions are:</description>
                            <lsb>24</lsb>
                            <msb>25</msb>
                            <access>write-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>00</name>
                                    <description>Disable flush</description>
                                    <value>#00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>Flush when queue is closed, discarding any new frames</description>
                                    <value>#01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>10</name>
                                    <description>Flush on queue close until empty, then stops flushing</description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>TRIGGER flush until empty, then return to current flush mode</description>
                                    <value>#11</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_QCLOSED_STATUS_P0_3</name>
                    <description>Queue Closed Status Register</description>
                    <addressOffset>0x3B78</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00ffffff</resetMask>
                    <fields>
                        <field>
                            <name>P0_STATUS</name>
                            <description>Per-queue closed status of Port 0 (1-bit per queue). A 0 indicates that the queue is open (enabled), and a 1 indicates that the queue is closed (disabled).</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>P1_STATUS</name>
                            <description>Per-queue closed status of Port 1 (1-bit per queue). A 0 indicates that the queue is open (enabled), and a 1 indicates that the queue is closed (disabled).</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>P2_STATUS</name>
                            <description>Per-queue closed status of Port 2 (1-bit per queue). A 0 indicates that the queue is open (enabled), and a 1 indicates that the queue is closed (disabled).</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>3</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-2</dimIndex>
                    <name>MMCTL_1FRAME_MODE_P%s</name>
                    <description>Port %s 1-Frame Mode Configuration Register</description>
                    <addressOffset>0x3B80</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00ff00ff</resetMask>
                    <fields>
                        <field>
                            <name>Q_1FRAME_ENA</name>
                            <description>1 bit per queue. Setting a bit to 1 enables the 1-frame mode for that queue for port n. In this mode, only one frame is allowed in the queue. If a new frame is received, the old frame is discarded.</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>Q_BUF_ENA</name>
                            <description>1 bit per queue. Setting a bit to 1 enables the buffer mode behavior for that queue for port n. This mode requires also that Q_1FRAME_ENA is set to 1.</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_P0_3_QUEUE_STATUS</name>
                    <description>Queue Status Indicator</description>
                    <addressOffset>0x3BA0</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00ffffff</resetMask>
                    <fields>
                        <field>
                            <name>P0_Q_STATUS</name>
                            <description>Port 0 Per-Queue Bit Indication</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>P1_Q_STATUS</name>
                            <description>Port 1 Per-Queue Bit Indication</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>P2_Q_STATUS</name>
                            <description>Port 2 Per-Queue Bit Indication</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_P0_3_FLUSH_STATUS</name>
                    <description>Queue Flush Status Indicator</description>
                    <addressOffset>0x3BA8</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00ffffff</resetMask>
                    <fields>
                        <field>
                            <name>P0_F_STATUS</name>
                            <description>Port 0 per-Queue Bit Indication on whether the queue is flushing frames (read 1) or not (read 0).</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>P1_F_STATUS</name>
                            <description>Port 1 per-Queue Bit Indication on whether the queue is flushing frames (read 1) or not (read 0).</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>P2_F_STATUS</name>
                            <description>Port 2 per-Queue Bit Indication on whether the queue is flushing frames (read 1) or not (read 0).</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_DLY_QTRIGGER_CTRL</name>
                    <description>Delayed Queue Trigger Control Register</description>
                    <addressOffset>0x3BB0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000100</resetValue>
                    <resetMask>0x7fffffff</resetMask>
                    <fields>
                        <field>
                            <name>DELAY_TIME</name>
                            <description>30-bit time in nanoseconds indicates the time after the trigger request from the pattern matchers to generate the event.</description>
                            <lsb>0</lsb>
                            <msb>29</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TIMER_SEL</name>
                            <description>Select the source timer to use for calculating the time.</description>
                            <lsb>30</lsb>
                            <msb>30</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Timer 0</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Timer 1</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_PREEMPT_QUEUES</name>
                    <description>Preemptable Queues Configures Register</description>
                    <addressOffset>0x3BB4</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000ffff</resetMask>
                    <fields>
                        <field>
                            <name>PREEMPT_ENA</name>
                            <description>Per-queue enable bit to configure which queues are used for preemptable traffic. Set to 1 the corresponding bit to configure a queue to be preemptable.</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PREEMPT_ON_QCLOSE</name>
                            <description>Per-queue configuration bit to enable preempting a frame when the queue goes from OPEN to CLOSED. When the corresponding bit is set to 1 and the queue is configured as preemptable in PREEMPT_ENA, a queue close event causes the current frame to be preempted, if preemption is operational.</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_HOLD_CONTROL</name>
                    <description>Request Preemption Register</description>
                    <addressOffset>0x3BB8</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00070007</resetMask>
                    <fields>
                        <field>
                            <name>Q_HOLD_REQ_FORCE</name>
                            <description>A per-port bit that forces a preempt request using MM_CTL.request (hold_req). When this bit is set to 1, it overrides other sources of hold request, including the TDMA controller.</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>Q_HOLD_REQ_RELEASE</name>
                            <description>A per-port bit that forces a release of preemption request using MM_CTL.request (hold_req). When this bit is set to 1, it overrides other sources of hold request, including the TDMA controller and Q_HOLD_REQ_FORCE[2:0].</description>
                            <lsb>16</lsb>
                            <msb>18</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_PREEMPT_STATUS</name>
                    <description>Preemption State Register</description>
                    <addressOffset>0x3BBC</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00070007</resetMask>
                    <fields>
                        <field>
                            <name>PREEMPT_STATE</name>
                            <description>A per-port bit that indicates if a port is in a preempted state. This is a real-time indication meant for debugging.</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>HOLD_REQ_STATE</name>
                            <description>A per-port bit that indicates if a port is preempted using MM_CTL.request (hold_req). This is a real-time indication meant for debugging.</description>
                            <lsb>16</lsb>
                            <msb>18</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-3</dimIndex>
                    <name>MMCTL_CQF_CTRL_P%s</name>
                    <description>Port %s Cyclic Queuing and Forwarding Control Register (n = 0 to 3)</description>
                    <addressOffset>0x3BC0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000ffff</resetMask>
                    <fields>
                        <field>
                            <name>PRIO_ENABLE0</name>
                            <description>A per-queue enable to select which ingress priorities are queued in the two CQF queues.</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>QUEUE_SEL0</name>
                            <description>Select which two physical queues are used for CQF. The queues used are QUEUE_SEL0 and QUEUE_SEL0 + 1. Frames are written into QUEUE_SEL0 when the gate control selected with GATE_SEL0 is 0, and into QUEUE_SEL0 + 1 when the gate control is 1.</description>
                            <lsb>8</lsb>
                            <msb>10</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>GATE_SEL0</name>
                            <description>Select which gate control signal is used for selecting the output queue (these signals are the same as the ETHSW_TDMAOUT pins).</description>
                            <lsb>11</lsb>
                            <msb>13</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>USE_SOP0</name>
                            <description>When set to 1, the CFQ queue is determined when the SOP is received at the frame writer in the memory controller. When set to 0, the queue is determined when the EOP is received at the frame writer.</description>
                            <lsb>14</lsb>
                            <msb>14</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>REF_SEL0</name>
                            <description>Select whether the gate control signal used for the CQF group is based on the egress port when set to 0, or the ingress port when set to 1.</description>
                            <lsb>15</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_P0_3_QCLOSED_NONEMPTY</name>
                    <description>Port Queue Status Register</description>
                    <addressOffset>0x3BE0</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>P0_Q_STATUS</name>
                            <description>Port 0 per-queue bit indication on whether the queue transitioned from open to closed state while frames were still queued.</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>P1_Q_STATUS</name>
                            <description>Port 1 per-queue bit indication on whether the queue transitioned from open to closed state while frames were still queued.</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>P2_Q_STATUS</name>
                            <description>Port 2 per-queue bit indication on whether the queue transitioned from open to closed state while frames were still queued.</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>P3_Q_STATUS</name>
                            <description>Port 3 per-queue bit indication on whether the queue transitioned from open to closed state while frames were still queued.</description>
                            <lsb>24</lsb>
                            <msb>31</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MMCTL_PREEMPT_EXTRA</name>
                    <description>Frame Preemption Extra Configuration Register</description>
                    <addressOffset>0x3BE8</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000040</resetValue>
                    <resetMask>0x000000ff</resetMask>
                    <fields>
                        <field>
                            <name>MIN_PFRM_ADJ</name>
                            <description>Adjust the minimum mPacket length, in increments of 4 bytes.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>LAST_PFRM_ADJ</name>
                            <description>Adjust the preemptable threshold when reaching the end of the frame, in increments of 4 bytes. Incrementing this value increments the length of the last mPacket.</description>
                            <lsb>4</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>DLR_CONTROL</name>
                    <description>DLR Control Register</description>
                    <addressOffset>0x3C00</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00006400</resetValue>
                    <resetMask>0x000fff17</resetMask>
                    <fields>
                        <field>
                            <name>ENABLE</name>
                            <description>Enable DLR extension module. When set, the DLR module becomes active. When DLR is enabled, the LOOP_FILTER_ENA must also be enabled for proper DLR operation.</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>AUTOFLUSH</name>
                            <description>Enable automatic flushing of unicast entries in address table if ring reconfiguration occurs (see also DLR interrupt IRQ_flush_macaddr_ena in DLR_IRQ_CONTROL).</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>LOOP_FILTER_ENA</name>
                            <description>Enable the loop filter function. When set to 1, the ingress loop filter is enabled. This can be enabled regardless of the DLR ENABLE state, allowing the loop filter function to operate when DLR is not used.</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IGNORE_INVTM</name>
                            <description>Enable ignore beacon frames with invalid timeout timer. When enabled (set to 1) frames with timeout timer value not within a range of 200 microseconds to 500 milliseconds are ignored and parameters are not locally stored or considered for state transitions. The invalid timeout timer value is always stored within the DLR_INV_TMOUT register irrespective of the value of this bit. Ignored frames are forwarded normally.</description>
                            <lsb>4</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>US_TIME</name>
                            <description>Number of clock cycles required for 1 microsecond for the switch operating clock. This LSI operates at 200 MHz, therefore this register must be set to 0xC8. The value after reset must be changed.</description>
                            <lsb>8</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>DLR_STATUS</name>
                    <description>DLR Status Register</description>
                    <addressOffset>0x3C04</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xff03ff03</resetMask>
                    <fields>
                        <field>
                            <name>LastBcnRcvPort</name>
                            <description>Last Beacon Receive Port</description>
                            <lsb>0</lsb>
                            <msb>1</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>NODE_STATE</name>
                            <description>Local Node Current State</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0x00</name>
                                    <description>IDLE_STATE</description>
                                    <value>0x00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x01</name>
                                    <description>NORMAL_STATE</description>
                                    <value>0x01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x02</name>
                                    <description>FAULT_STATE</description>
                                    <value>0x02</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Others</name>
                                    <description>Reserved</description>
                                    <isDefault>true</isDefault>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>LINK_STATUS</name>
                            <description>Link Status</description>
                            <lsb>16</lsb>
                            <msb>17</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>TOPOLOGY</name>
                            <description>Current Network Topology</description>
                            <lsb>24</lsb>
                            <msb>31</msb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0x00</name>
                                    <description>Linear topology when local node is in IDLE state</description>
                                    <value>0x00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x01</name>
                                    <description>Ring topology when local node is not in IDLE state</description>
                                    <value>0x01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Others</name>
                                    <description>Reserved</description>
                                    <isDefault>true</isDefault>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>DLR_ETH_TYP</name>
                    <description>DLR Ethernet Type Register</description>
                    <addressOffset>0x3C08</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x000080e1</resetValue>
                    <resetMask>0x0000ffff</resetMask>
                    <fields>
                        <field>
                            <name>DLR_ETH_TYP</name>
                            <description>Ethernet type to compare for DLR frame detection (initial value is 0x80E1)</description>
                            <lsb>0</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>DLR_IRQ_CONTROL</name>
                    <description>DLR Interrupt Control Register</description>
                    <addressOffset>0x3C0C</addressOffset>

                                    <description>No effect</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Clears each bit in the CHSTAT_n register</description>
                                    <value>#1</value>
                                </enumeratedValue>

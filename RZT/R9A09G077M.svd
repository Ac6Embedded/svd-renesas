                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>101</name>
                                    <description>5 IIC Phi cycles (When ICMR2.DLCS = 0 (IIC Phi)) 9 or 10 IIC Phi cycles (When ICMR2.DLCS = 1 (IIC Phi/2)) </description>

                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>IALK_ID_CONFIG</name>
                    <description>Configures Lookup Response Unknown IDs Register</description>
                    <addressOffset>0x0354</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000f00f3</resetMask>
                    <fields>
                        <field>
                            <name>INVLD_ID_FLOOD</name>
                            <description>Setting this bit to 1 causes the IA table to return a found response for frames whose ID lies outside the ID range defined by [IA_LK_MAX:IA_LK_MIN] using INVLD_ID_FLOOD_MASK[3:0] bits.</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>INVLD_ID_LRN_ENA</name>
                            <description>Setting this bit to 1 allows automatic learning into the L2 FDB for frames with unknown IDs. When 0, learning is inhibited. This bit is only valid when INVLD_ID_FLOOD bit is set to 1.</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>INVLD_ID_PRIO</name>
                            <description>Priority to use for found responses of an invalid ID. This bit is only valid when INVLD_ID_FLOOD bit is set to 1.</description>
                            <lsb>4</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>INVLD_ID_PRIO_VLD</name>
                            <description>Indicates if the priority in INVLD_ID_PRIO is valid. This bit is valid only when INVLD_ID_FLOOD bit is set to 1.</description>
                            <lsb>7</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>INVLD_ID_FLOOD_MASK</name>
                            <description>Forwarding mask used for frames whose ID is invalid. This bit is only valid when INVLD_ID_FLOOD bit is set to 1. Setting this mask to 0 causes the frame to be dropped.</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>IALK_VLAN_CONFIG</name>
                    <description>Configure Lookup Response Unknown VLAN Register</description>
                    <addressOffset>0x0358</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000f07f3</resetMask>
                    <fields>
                        <field>
                            <name>UNKWN_VLAN_FLOOD</name>
                            <description>When this bit is set to 1, a frame matching the OUI and with a valid ID but having a VLAN ID not matching any of the enabled values in IALK_VLANIDn causes the IA table to return a found response using the forwarding mask in UNKWN_VLAN_FLOOD_MASK[3:0].</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>UNKWN_VLAN_LRN_ENA</name>
                            <description>Setting this bit to 1 allows automatic learning into the L2 FDB for frames with unknown VLANs. When 0, learning is inhibited. This bit is only valid when UNKWN_VLAN_FLOOD bit is set to 1.</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>UNKWN_VLAN_PRIO</name>
                            <description>Priority to use for found responses for an unknown VLAN. This bit is only valid when UNKWN_VLAN_FLOOD bit is set to 1.</description>
                            <lsb>4</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>UNKWN_VLAN_PRIO_VLD</name>
                            <description>Indicates if the priority in UNKWN_VLAN_PRIO[2:0] is valid. This bit is only valid when UNKWN_VLAN_FLOOD bit is set to 1.</description>
                            <lsb>7</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VLANS_ENABLED</name>
                            <description>Configures the logical geometry of the IA table by specifying the number of distinct VLAN IDs enabled. When set to 0, no VLANs are supported and the VLAN ID for the frames is ignored.</description>
                            <lsb>8</lsb>
                            <msb>10</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>UNKWN_VLAN_FLOOD_MASK</name>
                            <description>Forwarding mask used for frames with an unknown VLAN ID.</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>IALK_TBL_ADDR</name>
                    <description>IA Lookup Database Address Register</description>
                    <addressOffset>0x035C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xf0001fff</resetMask>
                    <fields>
                        <field>
                            <name>ADDR</name>
                            <description>Defines the address to write to or read from the IA Lookup table</description>
                            <lsb>0</lsb>
                            <msb>12</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>AINC</name>
                            <description>Auto-Increment Control</description>
                            <lsb>28</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>IALK_TBL_DATA</name>
                    <description>IA Lookup Database Data Register</description>
                    <addressOffset>0x0360</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000001f</resetMask>
                    <fields>
                        <field>
                            <name>VALID</name>
                            <description>Indicates whether the entry indicated by ADDR is valid or not.</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>FWD_MASK</name>
                            <description>Forwarding mask used for lookups that hit the entry and when VALID is set to 1.</description>
                            <lsb>1</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-3</dimIndex>
                    <name>IALK_VLANID%s</name>
                    <description>IA Lookup VLANIDn Register</description>
                    <addressOffset>0x0380</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xf00f3fff</resetMask>
                    <fields>
                        <field>
                            <name>VLANID</name>
                            <description>Configure the VLAN ID to be used for VLAN n (n: IALK_VLAN_CONFIG.VLANS_ENABLED). This bit is only valid when VLANID_ENA bit is set to 1. A value of 0 matches any VLAN ID.</description>
                            <lsb>0</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VLANID_ENA</name>
                            <description>Enables this VLAN ID. When set to 1, the VLAN ID of the frame is compared against VLANID[11:0].</description>
                            <lsb>12</lsb>
                            <msb>12</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VLANID_LRN_ENA</name>
                            <description>Configures whether automatic learning in the L2 FDB is allowed for frames matching VLAN ID. This also includes frames that match the VLAN ID and that the entry in the IA table is invalid.</description>
                            <lsb>13</lsb>
                            <msb>13</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VLANID_FLOOD_MASK</name>
                            <description>Flooding mask to be used for frames matching this VLAN ID but with an invalid entry in the IA table.</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VLANID_PRIO</name>
                            <description>Priority to use for found responses.</description>
                            <lsb>28</lsb>
                            <msb>30</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VLANID_PRIO_VLD</name>
                            <description>Indicates if the priority in VLANID_PRIO[2:0] is valid.</description>
                            <lsb>31</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-3</dimIndex>
                    <name>IMC_QLEVEL_P%s</name>
                    <description>Port %s Queued Frame Count Register</description>
                    <addressOffset>0x03C0</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>QUEUE0</name>
                            <description>A 4-bit value per queue indicating the number of frames stored in queue 0</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>QUEUE1</name>
                            <description>A 4-bit value per queue indicating the number of frames stored in queue 1</description>
                            <lsb>4</lsb>
                            <msb>7</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>QUEUE2</name>
                            <description>A 4-bit value per queue indicating the number of frames stored in queue 2</description>
                            <lsb>8</lsb>
                            <msb>11</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>QUEUE3</name>
                            <description>A 4-bit value per queue indicating the number of frames stored in queue 3</description>
                            <lsb>12</lsb>
                            <msb>15</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>QUEUE4</name>
                            <description>A 4-bit value per queue indicating the number of frames stored in queue 4</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>QUEUE5</name>
                            <description>A 4-bit value per queue indicating the number of frames stored in queue 5</description>
                            <lsb>20</lsb>
                            <msb>23</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>QUEUE6</name>
                            <description>A 4-bit value per queue indicating the number of frames stored in queue 6</description>
                            <lsb>24</lsb>
                            <msb>27</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>QUEUE7</name>
                            <description>A 4-bit value per queue indicating the number of frames stored in queue 7</description>
                            <lsb>28</lsb>
                            <msb>31</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LK_CTRL</name>
                    <description>Learning/Lookup Function Global Configuration Register</description>
                    <addressOffset>0x0400</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x0000004f</resetValue>
                    <resetMask>0x000f00df</resetMask>
                    <fields>
                        <field>
                            <name>LKUP_EN</name>
                            <description>Lookup Controller Enable</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>LEARN_EN</name>
                            <description>Learning Enable</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>AGING_EN</name>
                            <description>Aging Enable</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>ALW_MGRT</name>
                            <description>Allow Migration</description>
                            <lsb>3</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>DISC_UNK_DEST</name>
                            <description>Discard Unknown Destination</description>
                            <lsb>4</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CLRTBL</name>
                            <description>Clear Table</description>
                            <lsb>6</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IND_VLAN</name>
                            <description>Enable Independent VLAN Learning</description>
                            <lsb>7</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>DISC_UNK_SRC</name>
                            <description>Discard Unknown Source</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LK_STATUS</name>
                    <description>Status Bits and Table Overflow Counter Register</description>
                    <addressOffset>0x0404</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000001</resetValue>
                    <resetMask>0xbfffffff</resetMask>
                    <fields>
                        <field>
                            <name>AGEADDR</name>
                            <description>Address the aging process will inspect when the aging timer expires next time.</description>
                            <lsb>0</lsb>
                            <msb>15</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>OVRF</name>
                            <description>Counts number of table overflows that occurred (a new address was learned but the table had no storage and an older entry was deleted). The counter is cleared by writing into the register and having bit 16 set to 1.</description>
                            <lsb>16</lsb>
                            <msb>29</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>LRNEVNT</name>
                            <description>Learn Event</description>
                            <lsb>31</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LK_ADDR_CTRL</name>
                    <description>Address Table Transaction Control and Read/Write Address</description>
                    <addressOffset>0x0408</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffc00fff</resetMask>
                    <fields>
                        <field>
                            <name>ADDR_MSK</name>
                            <description>Memory address for read and write transactions. This is the address of a 69-bit entry. For the DEL_PORT bit, a port mask can be provided in these bits instead of the address. Bit 0 represents port 0, bit 1 port 1, and so on.</description>
                            <lsb>0</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CLR_DYNAMIC</name>
                            <description>When set to 1, scans the complete table for valid dynamic entries and deletes them (writes entry with all 0s). This bit is cleared when the function has completed.</description>
                            <lsb>22</lsb>
                            <msb>22</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CLR_STATIC</name>
                            <description>When set to 1, scans the complete table for valid static entries and deletes them (writes entry with all 0s). This bit is cleared when the function has completed.</description>
                            <lsb>23</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>GETLASTNEW</name>
                            <description>When set to 1, retrieves the last source address that was not found in the table and places it into LK_DATA_LO/HI/HI2. The valid bit of the entry (bit LK_DATA_HI[16]) indicates if the address is new (when valid bit is 1) or not (when valid bit is 0) since the command was last issued.</description>
                            <lsb>24</lsb>
                            <msb>24</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>WRITE</name>
                            <description>When set to 1, perform a single write transaction.</description>
                            <lsb>25</lsb>
                            <msb>25</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>READ</name>
                            <description>When set to 1, perform a single read transaction.</description>
                            <lsb>26</lsb>
                            <msb>26</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>WAIT_COMP</name>
                            <description>When set to 1, instructs to stall the processor bus until the transaction is completed. This allows performing of consecutive writes into this register with varying commands without the need for polling the BUSY bit.</description>
                            <lsb>27</lsb>
                            <msb>27</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>LOOKUP</name>
                            <description>When set to 1, perform a lookup of the MAC address given in LK_DATA_LO/HI/HI2.</description>
                            <lsb>28</lsb>
                            <msb>28</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>CLEAR</name>
                            <description>When set to 1, writes all 0s to the entry selected by the given address set in ADDR_MSK[11:0]. If this bit is set together with the LOOKUP bit, first a lookup is performed and if the lookup succeeds, the entry is then deleted. The registers LK_DATA_LO/HI/HI2 are also cleared. The memory address in this register is set from the lookup result. If the lookup failed, the clear command is ignored and memory address is arbitrary.</description>
                            <lsb>29</lsb>
                            <msb>29</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>DEL_PORT</name>
                            <description>When set to 1, scans the complete table for valid dynamic entries that contain the given ports in their destination port mask and deletes the ports or the complete entry. The port mask is provided in the ADDR_MSK[3:0] when writing this register (1 bit per port, bit 0 = port 0, bit 1 = port 1, and so on).</description>
                            <lsb>30</lsb>
                            <msb>30</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>BUSY</name>
                            <description>Transaction Busy Indication</description>
                            <lsb>31</lsb>
                            <msb>31</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LK_DATA_LO</name>
                    <description>Lower 32-Bit Data of Lookup Memory Entry</description>
                    <addressOffset>0x040C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MEMDATA</name>
                            <description>Memory Data [31:0]</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LK_DATA_HI</name>
                    <description>Higher 25-Bit Data of Lookup Memory Entry</description>
                    <addressOffset>0x0410</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x01ffffff</resetMask>
                    <fields>
                        <field>
                            <name>MEMDATA</name>
                            <description>Memory Data [56:32]</description>
                            <lsb>0</lsb>
                            <msb>24</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LK_DATA_HI2</name>
                    <description>Higher2 12-Bit Data of Lookup Memory Entry</description>
                    <addressOffset>0x0414</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000fff00</resetMask>
                    <fields>
                        <field>
                            <name>MEMDATA</name>
                            <description>Memory Data [68:57]</description>
                            <lsb>8</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LK_LEARNCOUNT</name>
                    <description>Learned Address Count Register</description>
                    <addressOffset>0x0418</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xc0001fff</resetMask>
                    <fields>
                        <field>
                            <name>LEARNCOUNT</name>
                            <description>Number of Learned Addresses</description>
                            <lsb>0</lsb>
                            <msb>12</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>WRITE_MD</name>
                            <description>These bits define how the LEARNCOUNT value is modified when writing into the register:</description>
                            <lsb>30</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>00</name>
                                    <description>Sets LEARNCOUNT to given value</description>
                                    <value>#00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>Increments the LEARNCOUNT value by 1 (atomic)</description>
                                    <value>#01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>10</name>
                                    <description>Decrements the LEARNCOUNT value by 1 (atomic)</description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>Reserved, write has no effect on LEARNCOUNT</description>
                                    <value>#11</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LK_AGETIME</name>
                    <description>Period of the Aging Timer</description>
                    <addressOffset>0x041C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00004000</resetValue>
                    <resetMask>0x00ffffff</resetMask>
                    <fields>
                        <field>
                            <name>AGETIME</name>
                            <description>24-bit Timer Value</description>
                            <lsb>0</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MGMT_TAG_CONFIG</name>
                    <description>Management Tag Configuration Register</description>
                    <addressOffset>0x0480</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0xe0010000</resetValue>
                    <resetMask>0xffff0033</resetMask>
                    <fields>
                        <field>
                            <name>ENABLE</name>
                            <description>Enable Management Tag Insertion Module</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>AL_FRAMES</name>
                            <description>Enable Tag Insertion for All Frames</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TYPE1_EN</name>
                            <description>When set, frames with a Type field that match the value in PRIORITY_TYPE1.TYPEVAL[15:0] have management tag inserted. This is in addition to BPDU frames which always have tag inserted.</description>
                            <lsb>4</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TYPE2_EN</name>
                            <description>When set, frames with a Type field that match the value in PRIORITY_TYPE2.TYPEVAL[15:0] have management tag inserted. This is in addition to BPDU frames which always have tag inserted.</description>
                            <lsb>5</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TAGFIELD</name>
                            <description>The value of the tag that is found in the first Type/Length field of the frame to identify that the control information is present within a frame. For example, [31:24] = first octet, [23:16] = 2nd octet.</description>
                            <lsb>16</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>TSM_CONFIG</name>
                    <description>Timestamping Control Module Configuration Register</description>
                    <addressOffset>0x504</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000f3337</resetMask>
                    <fields>
                        <field>
                            <name>IRQ_EN</name>
                            <description>Final Interrupt enable</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_TEST</name>

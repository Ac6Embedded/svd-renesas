                    <addressOffset>0x3C74</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>RX_ERR_STAT1</name>
                            <description>Number of Beacon Frames Received with CRC Error on Port 1</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>DLR_RX_LF_STAT1</name>
                    <description>DLR Received Frame Loop Filter Statistic Register 1</description>
                    <addressOffset>0x3C7C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000000ff</resetMask>
                    <fields>
                        <field>
                            <name>RX_LF_STAT1</name>
                            <description>Number of discarded frames in port 1 due to loop filtering when LOOP_FILTER_ENA is set to 1. Saturates at 255.</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PRP_CONFIG</name>
                    <description>PRP Configuration Register</description>
                    <addressOffset>0x3D00</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000103ff</resetMask>
                    <fields>
                        <field>
                            <name>PRP_ENA</name>
                            <description>Enable PRP Operation</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RX_DUP_ACCEPT</name>
                            <description>Enable Duplicate Accept Mode of Operation at Receive</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RX_REMOVE_RCT</name>
                            <description>Allow PRP Port RX to Remove the RCT</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TX_RCT_MODE</name>
                            <description>Control Appending the RCT to Transmitted Frames on the Redundant Ports</description>
                            <lsb>3</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>00</name>
                                    <description>Append RCT if group only: Append RCT, if frame is duplicated to exactly the ports listed in the PRP_GROUP register. If the frame is sent to only one of the ports or is for example, flooded also to other ports, no RCT is appended.</description>
                                    <value>#00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>Append RCT to group always: Append the RCT always if the frame is duplicated to at least the two ports listed in the PRP_GROUP. This includes flooded frames even if they are additionally sent on other ports outside the PRP_GROUP. If the frame is sent to only one of the PRP_GROUP ports, no RCT is appended.</description>
                                    <value>#01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>10</name>
                                    <description>Disable RCT append: The transmitters do not append the RCT even if frames are duplicated to the PRP_GROUP ports. This represents the IEC: 4.2.6 duplicate accept mode of operation.</description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>Append RCT always forced: The transmitters append the RCT to all frames transmitted on any of the PRP_GROUP ports, no matter if they are duplicated or not or if they are flooded.</description>
                                    <value>#11</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>TX_RCT_BROADCAST</name>
                            <description>Should be 1 normally.</description>
                            <lsb>5</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Do not append RCT to broadcast frames. This further restricts modes 00b, 01b, 11b.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Allow appending RCT to broadcast frames.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>TX_RCT_MULTICAST</name>
                            <description>Should be 1 normally.</description>
                            <lsb>6</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Do not append RCT to multicast frames. This further restricts modes 00b, 01b, 11b.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Allow appending RCT to multicast frames.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>TX_RCT_UNKNOWN</name>
                            <description>Should be 1 normally.</description>
                            <lsb>7</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Do not append RCT to frames flooded because the destination is unknown. This further restricts modes 00b, 01b, 11b.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Allow appending RCT to frames that have unknown destination and are hence flooded.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>TX_RCT_1588</name>
                            <description>Setting this bit affects IEEE 1588 frames that are forwarded through the switch (for example, when used as RedBox) to both PRP_GROUP ports. Locally generated IEEE 1588 frames (peer-delay request/response) are not affected by this setting.</description>
                            <lsb>8</lsb>
                            <msb>8</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Do not append RCT to IEEE 1588 frames (frame type 0x88F7) frames even if they are duplicated.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Allow appending RCT to IEEE 1588 frames. Defines to treat those frames as any other frame according to the configured TX_RCT_xxx settings above.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>RCT_LEN_CHK_DIS</name>
                            <description>When set to 1, disables the RCT length field checking against the actual frame length.</description>
                            <lsb>9</lsb>
                            <msb>9</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRP_AGE_ENA</name>
                            <description>Enable History Memory Aging Timer</description>
                            <lsb>16</lsb>
                            <msb>16</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PRP_GROUP</name>
                    <description>PRP Port Group Register</description>
                    <addressOffset>0x3D04</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00070007</resetMask>
                    <fields>
                        <field>
                            <name>PRP_GROUP</name>

                        <field>
                            <name>IRQ_state_chng_ena</name>
                            <description>Enable Interrupt for State Change</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_flush_macaddr_ena</name>
                            <description>Enable Flush Local MAC Address Table Interrupt.</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_stop_nbchk0_ena</name>
                            <description>Enable Stop Request Neighbor Check Timeout Timer Interrupt for Port 0.</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_stop_nbchk1_ena</name>
                            <description>Enable Stop Request Neighbor Check Timeout Timer Interrupt for Port 1.</description>
                            <lsb>3</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_bec_tmr0_exp_ena</name>
                            <lsb>4</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_bec_tmr1_exp_ena</name>
                            <description>Enable Interrupt on Beacon Timeout Timer Expire for Port 1.</description>
                            <lsb>5</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_supr_chng_ena</name>
                            <description>Enable Interrupt on Ring Supervisor Change.</description>
                            <lsb>6</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_link_chng0_ena</name>
                            <description>Enable Link Status Change Interrupt Event for Port 0.</description>
                            <lsb>7</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_link_chng1_ena</name>
                            <description>Enable Link Status Change Interrupt Event for Port 1.</description>
                            <lsb>8</lsb>
                            <msb>8</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_sup_ignord_ena</name>
                            <description>Enable interrupt on beacon frame detection from a supervisor with lower precedence than the current ring supervisor or lower numeric value for MAC address when precedence is same.</description>
                            <lsb>9</lsb>
                            <msb>9</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_ip_addr_chng_ena</name>
                            <description>Enable interrupt on IP address change detection within beacon frame from ring supervisor.</description>
                            <lsb>10</lsb>
                            <msb>10</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_invalid_tmr_ena</name>
                            <description>Enable interrupt on invalid range for beacon timeout timer value detection.</description>
                            <lsb>11</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_bec_rcv0_ena</name>
                            <description>Enable interrupt on beacon frame detection on port 0.</description>
                            <lsb>12</lsb>
                            <msb>12</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_bec_rcv1_ena</name>
                            <description>Enable interrupt on beacon frame detection on port 1.</description>
                            <lsb>13</lsb>
                            <msb>13</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_frm_dscrd0</name>
                            <description>Enable interrupt on frame discard due to source address match with the local address on port 0.</description>
                            <lsb>14</lsb>
                            <msb>14</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IRQ_frm_dscrd1</name>
                            <description>Enable Interrupt on Frame discard due to source address match with the local address on port 1.</description>
                            <lsb>15</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>low_int_en</name>
                            <description>Enable active-low interrupt. Asserted to use active-low interrupt signal instead of active-high interrupt signal.</description>
                            <lsb>29</lsb>
                            <msb>29</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>atomic_OR</name>
                            <description>When set during a register-write, the enable bits are ORed into the current setting of the register. By writing this bit at the same time, only the target bit can be set to 1.</description>
                            <lsb>30</lsb>
                            <msb>30</msb>
                            <access>write-only</access>
                        </field>
                        <field>
                            <name>atomic_AND</name>
                            <description>When set during a register-write, the enable bits are ANDed with the current setting of the register. By writing this bit at the same time, only the target bit can be set to 0.</description>
                            <lsb>31</lsb>
                            <msb>31</msb>
                            <access>write-only</access>
                        </field>
                    </fields>
                </register>

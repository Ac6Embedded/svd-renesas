                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Indirect addressing of "long messages". During this operation, the stored address content in the given database entry is evaluated.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>LOFF</name>
                            <description>Long message addressing mode/long message error</description>

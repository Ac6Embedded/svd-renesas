                    <access>read-write</access>
                    <resetValue>0x0000000f</resetValue>
                    <resetMask>0x0000000f</resetMask>
                    <fields>
                        <field>
                            <name>UCASTDM1</name>
                            <description>Default Unicast Resolution Mask 1</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>BCAST_DEFAULT_MASK1</name>
                    <description>Broadcast Default Mask Register 1</description>
                    <addressOffset>0x74</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x0000000f</resetValue>
                    <resetMask>0x0000000f</resetMask>
                    <fields>
                        <field>
                            <name>BCASTDM1</name>
                            <description>Default Broadcast Resolution Mask 1</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCAST_DEFAULT_MASK1</name>
                    <description>Multicast Default Mask Register 1</description>
                    <addressOffset>0x78</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x0000000f</resetValue>
                    <resetMask>0x0000000f</resetMask>
                    <fields>
                        <field>
                            <name>MCASTDM1</name>
                            <description>Default Multicast Resolution Mask 1</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PORT_XCAST_MASK_SEL</name>
                    <description>Port Mask Select Register</description>
                    <addressOffset>0x7C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000000f</resetMask>
                    <fields>
                        <field>
                            <name>MSEL</name>
                            <description>Mask Select</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>QMGR_ST_MINCELLS</name>
                    <description>Minimum Memory Cell Statistics Register </description>
                    <addressOffset>0x88</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000007ff</resetMask>
                    <fields>
                        <field>
                            <name>STMINCELLS</name>
                            <description>Minimum Free Cell Indication</description>
                            <lsb>0</lsb>
                            <msb>10</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>QMGR_RED_MIN4</name>
                    <description>RED Minimum Threshold Register</description>
                    <addressOffset>0x94</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x0f0f0f0f</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>CFGRED_MINTH4</name>
                            <description>Random Early Detection (RED) Minimum Threshold for Queues 0 to 3</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>QMGR_RED_MAX4</name>
                    <description>RED Maximum Threshold Register</description>
                    <addressOffset>0x98</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x2f2f2f2f</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>CFGRED_MAXTH4</name>
                            <description>Random Early Detection (RED) Maximum Threshold for Queues 0 to 3</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>QMGR_RED_CONFIG</name>
                    <description>RED Configuration Register</description>
                    <addressOffset>0x9C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000010f</resetMask>
                    <fields>
                        <field>
                            <name>QUEUE_RED_EN</name>
                            <description>Enable Random Early Detection (RED) (when this bit is 1) or Tail Drop (when this bit is 0) congestion management for a queue.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>GACTIVITY_EN</name>
                            <description>Enable Averaging on Global Switch Activity (when this bit is 1) or on port local activity (when this bit is 0) only.</description>
                            <lsb>8</lsb>
                            <msb>8</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>IMC_STATUS</name>
                    <description>Input Memory Controller Status Register</description>
                    <addressOffset>0xA0</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0fffffff</resetMask>
                    <fields>
                        <field>
                            <name>CELLS_AVAILABLE</name>
                            <description>Total number of memory cells (128-byte units) available in the shared memory (real time).</description>
                            <lsb>0</lsb>
                            <msb>23</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>CF_ERR</name>
                            <description>Cell Factory Empty Error</description>
                            <lsb>24</lsb>
                            <msb>24</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>DE_ERR</name>
                            <description>Deallocation Error</description>
                            <lsb>25</lsb>
                            <msb>25</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>DE_INIT</name>
                            <description>Asserts during Memory Initialization (deallocation module)</description>
                            <lsb>26</lsb>
                            <msb>26</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>MEM_FULL</name>
                            <description>Latched Indication that Memory is or was Full</description>
                            <lsb>27</lsb>
                            <msb>27</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>IMC_ERR_FULL</name>
                    <description>Input Port Memory Full and Truncation Indicator Register</description>
                    <addressOffset>0xA4</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000f000f</resetMask>
                    <fields>
                        <field>
                            <name>IPC_ERR_FULL</name>
                            <description>Memory was full at start of a frame reception.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>IPC_ERR_TRUNC</name>
                            <description>Memory became full while a frame was received and was partly written into memory.</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>IMC_ERR_IFACE</name>
                    <description>Input Port Memory Error Indicator Register</description>
                    <addressOffset>0xA8</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000f000f</resetMask>
                    <fields>
                        <field>
                            <name>IPC_ERR_IFACE</name>
                            <description>Error indication on memory input (receive from MAC) that a frame has been truncated and discarded.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>WBUF_OVF</name>
                            <description>Error indicating an overflow in the input write buffer to the memory controller (a small decoupling FIFO at every MAC RX).</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>IMC_ERR_QOFLOW</name>
                    <description>Output Port Queue Overflow Indicator Register</description>
                    <addressOffset>0xAC</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000000f</resetMask>
                    <fields>
                        <field>
                            <name>OP_ERR</name>
                            <description>A frame cannot be stored in an output queue of the port as the queue FIFO overflowed (write occurred into full fifo). The frame is ignored but stays stored in memory. This should not occur during normal operation. This is a fatal error as the memory allocated by that frame is not freed, and resulting in memory leakage.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>IMC_CONFIG</name>
                    <description>Input Memory Controller Configuration Register</description>
                    <addressOffset>0xB0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000003f</resetMask>
                    <fields>
                        <field>
                            <name>WFQ_EN</name>
                            <description>Enable weighted fair queuing (when this bit is 1) or strict priority (when this bit is 0, default) output queue scheduling.</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RSV_ENA</name>
                            <description>Enable Memory Reservations to Operate</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SPEED_HIPRI_THR</name>
                            <description>High-Priority Speed Threshold</description>
                            <lsb>2</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CTFL_EMPTY_MD</name>
                            <description>When this bit is set to 0, a frame received in Cut-Through mode that cannot allocate an entry in the CTFL is forwarded as store and forward.</description>
                            <lsb>5</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>IMC_ERR_ALLOC</name>
                    <description>Input Port Error Indicator Register</description>
                    <addressOffset>0xB4</addressOffset>
                    <size>32</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000f000f</resetMask>
                    <fields>
                        <field>
                            <name>DISC_FULL</name>
                            <description>Per port discard indication due to memory pool going empty. Per port indication that one of the queues was full and a frame was discarded.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-only</access>
                        </field>
                        <field>
                            <name>DISC_LATE</name>
                            <description>Per port discard indication due to lateness in the priority resolution. The priority resolution can be delayed by the pattern matchers. If it arrives too late (after approximately 100 bytes into the frame), the frame is discarded.</description>
                            <lsb>16</lsb>
                            <msb>19</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-3</dimIndex>
                    <name>GPARSER%s</name>
                    <description>[n + 1]th Parser of 1st Block</description>
                    <addressOffset>0x00C0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x7fbfffff</resetMask>
                    <fields>
                        <field>
                            <name>MASK_VAL2</name>
                            <description>Mask for single byte compares or 2nd compare value (if bit 30 = 1) or least significant bits of a 16-bit compare value (if bit 28 = 1). When used as a mask (bit 28, 30 = 0, 0), the data from the frame is ANDed with this mask, then compared to the compare value. All bits having a 1 in the mask will be compared with the data in the frame. All bits having a 0 will be 0 for the compare, however this requires the compare value to have those bits also set to 0.</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>COMPARE_VAL</name>
                            <description>The value to compare the frame data with at the given offset.</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OFFSET</name>
                            <description>An offset in bytes where to find the data for comparison within the frame. The offset value starts at 0 to indicate the very first byte after offset start. The offset start can be either the type/length field of the frame, that is, 0 = first byte of type/length field) or the payload following an IP header (see IPDATA). Valid values range from 0 to 60.</description>
                            <lsb>16</lsb>
                            <msb>21</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OFFSET_DA</name>
                            <description>When set, the offset starts counting from the first byte of the MAC destination address.</description>
                            <lsb>23</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VALID</name>
                            <description>Indicate that this entry is valid (when this bit is 1) and should be used. When this bit is 0, the parser result always indicates &quot;no match&quot; and none of the other bits are relevant.</description>
                            <lsb>24</lsb>
                            <msb>24</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SKIPVLAN</name>
                            <description>When set, any optional VLAN tags found in the frame are skipped and the parser starts operating at the first byte following any VLAN tags. When cleared, the parser starts with the first byte following the source MAC address.</description>
                            <lsb>25</lsb>
                            <msb>25</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IPDATA</name>
                            <description>When set, the offset starts with the first byte following an IP header if an IP frame is processed. The following fields are skipped:</description>
                            <lsb>26</lsb>
                            <msb>26</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IPPROTOCOL</name>
                            <description>When set, the compare value is compared with the protocol field found within the IP header for both IPv4 and IPv6 frames. It implicitly acts as SKIPVLAN = 1 skipping any VLAN tags if present. The offset setting has no meaning and is ignored.</description>
                            <lsb>27</lsb>
                            <msb>27</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CMP16</name>
                            <description>When set, MASK_VAL2[7:0] is used as a value to perform a 16-bit compare. COMPARE_VAL[7:0] represent the byte at the given offset and MASK_VAL2[7:0] represent the byte following at offset + 1 which matches the network byte order for 16-bit fields. For example, setting a compare value of 0x0800 and offset 0 matches IP frames. No mask is available in this mode.</description>
                            <lsb>28</lsb>
                            <msb>28</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OFFSET_PLUS2</name>
                            <description>Repeats the comparison at offset + 2, if the comparison at offset failed.</description>
                            <lsb>29</lsb>
                            <msb>29</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CMP_MASK_OR</name>
                            <description>Use the MASK_VAL2[7:0] bits as a 2nd compare value. When set, the parser reports a match if the byte at given offset matches COMPARE_VAL[7:0] or MASK_VAL2[7:0].</description>
                            <lsb>30</lsb>
                            <msb>30</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-3</dimIndex>
                    <name>GARITH%s</name>
                    <description>Snoop Configuration for Arithmetic [n + 1]th Stage of 1st Block</description>
                    <addressOffset>0x00D0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00337f0f</resetMask>
                    <fields>
                        <field>
                            <name>NOT_INP</name>
                            <description>Not Input</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SEL_MATCH</name>
                            <description>Select Match</description>
                            <lsb>8</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SEL_ARITH0</name>
                            <description>Select Arithmetic Stage 0</description>
                            <lsb>12</lsb>
                            <msb>12</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SEL_ARITH1</name>
                            <description>Select Arithmetic Stage 1</description>
                            <lsb>13</lsb>
                            <msb>13</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SEL_ARITH2</name>
                            <description>Select Arithmetic Stage 2</description>
                            <lsb>14</lsb>
                            <msb>14</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OP</name>
                            <description>Operation</description>
                            <lsb>16</lsb>
                            <msb>16</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>AND all selected inputs</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>OR all selected inputs</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>RESULT_INV</name>
                            <description>Result Invert</description>
                            <lsb>17</lsb>
                            <msb>17</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>The output is used directly.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The output of this stage is inverted.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>SNP_MD</name>
                            <description>Snoop Mode</description>
                            <lsb>20</lsb>
                            <msb>21</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>00</name>
                                    <description>Disabled, no snooping occurs (forward normally)</description>
                                    <value>#00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>Forward to designated management port only</description>
                                    <value>#01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>10</name>
                                    <description>Forward normally and copy to management port</description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>Discard the frame</description>
                                    <value>#11</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>4-7</dimIndex>
                    <name>GPARSER%s</name>
                    <description>[n - 3]th Parser of 2nd Block</description>
                    <addressOffset>0x00E0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x7fbfffff</resetMask>
                    <fields>
                        <field>
                            <name>MASK_VAL2</name>
                            <description>Mask for single byte compares or 2nd compare value (if bit 30 = 1) or least significant bits of a 16-bit compare value (if bit 28 = 1). When used as a mask (bit 28, 30 = 0, 0), the data from the frame is ANDed with this mask, then compared to the compare value. All bits having a 1 in the mask are compared with the data in the frame. All bits having a 0 will be 0 for the compare, however this requires the compare value to have those bits also set to 0.</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>COMPARE_VAL</name>
                            <description>The value to compare the frame data with at the given offset.</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OFFSET</name>
                            <description>An offset in bytes to locate the data for comparison within the frame. The offset value starts at 0 to indicate the very first byte after offset start. The offset start can be either the type or length field of the frame, for example 0 = first byte of type/length field) or the payload following an IP header (see bit 26). Valid values range from 0 to 60.</description>
                            <lsb>16</lsb>
                            <msb>21</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OFFSET_DA</name>
                            <description>When set, the offset starts counting from the first byte of the MAC destination address.</description>
                            <lsb>23</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VALID</name>
                            <description>Indicates that this entry is valid (when this bit is 1) and should be used. When this bit is 0, the parser result always indicates "no match" and none of the other bits are relevant.</description>
                            <lsb>24</lsb>
                            <msb>24</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SKIPVLAN</name>
                            <description>When set, any optional VLAN tags found in the frame are skipped and the parser starts operating at the first byte following any VLAN tags. When cleared, the parser starts with the first byte following the source MAC address.</description>
                            <lsb>25</lsb>
                            <msb>25</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IPDATA</name>
                            <description>When set, the offset starts with the first byte following an IP header if an IP frame is processed. The following fields are skipped:</description>
                            <lsb>26</lsb>
                            <msb>26</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>IPPROTOCOL</name>
                            <description>When set, the compare value is compared with the protocol field located within the IP header for both IPv4 and IPv6 frames. It implicitly acts as SKIPVLAN = 1 skipping any VLAN tags if present. The offset setting has no meaning and is ignored. If the bit is set, but the frame is not an IPv4/v6 frame the parser reports a no match and does not continue to inspect the frame. When cleared, the offset is used normally on all frames.</description>
                            <lsb>27</lsb>
                            <msb>27</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CMP16</name>
                            <description>When set, MASK_VAL2[7:0] is used as a value to perform a 16-bit compare. COMPARE_VAL[7:0] represents the byte at the given offset and MASK_VAL2[7:0] represents the byte following at offset + 1 which matches the network byte order for 16-bit fields, (for example setting a compare value of 0x0800 and offset 0 matches IP frames). No mask is available in this mode.</description>
                            <lsb>28</lsb>
                            <msb>28</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OFFSET_PLUS2</name>
                            <description>Repeats the comparison at offset + 2, if the comparison at offset failed.</description>
                            <lsb>29</lsb>
                            <msb>29</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>CMP_MASK_OR</name>
                            <description>Use MASK_VAL2[7:0] as a second compare value. When set, the parser reports a match if the byte at given offset matches COMPARE_VAL[7:0] or MASK_VAL2[7:0].</description>
                            <lsb>30</lsb>
                            <msb>30</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>4-7</dimIndex>
                    <name>GARITH%s</name>
                    <description>Snoop Configuration for Arithmetic [n - 3]th Stage of 2nd Block</description>
                    <addressOffset>0x00F0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x00337f0f</resetMask>
                    <fields>
                        <field>
                            <name>NOT_INP</name>
                            <description>Not Input</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SEL_MATCH</name>
                            <description>Select Match</description>
                            <lsb>8</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SEL_ARITH0</name>
                            <description>Select Arithmetic Stage 0</description>
                            <lsb>12</lsb>
                            <msb>12</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SEL_ARITH1</name>
                            <description>Select Arithmetic Stage 1</description>
                            <lsb>13</lsb>
                            <msb>13</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SEL_ARITH2</name>
                            <description>Select Arithmetic Stage 2</description>
                            <lsb>14</lsb>
                            <msb>14</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OP</name>
                            <description>Operation</description>
                            <lsb>16</lsb>
                            <msb>16</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>AND all selected inputs</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>OR all selected inputs</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>RESULT_INV</name>
                            <description>Result Invert</description>
                            <lsb>17</lsb>
                            <msb>17</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>The output is used directly</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The output of this stage is inverted</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>SNP_MD</name>
                            <description>Snoop Mode</description>
                            <lsb>20</lsb>
                            <msb>21</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>00</name>
                                    <description>Disabled, no snooping occurs (forward normally)</description>
                                    <value>#00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>Forward to designated management port only</description>
                                    <value>#01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>10</name>
                                    <description>Forward normally and copy to management port</description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>Discard the frame</description>
                                    <value>#11</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-3</dimIndex>
                    <name>VLAN_PRIORITY%s</name>
                    <description>VLAN Priority Register %s</description>
                    <addressOffset>0x0100</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x006db688</resetValue>
                    <resetMask>0x00ffffff</resetMask>
                    <fields>
                        <field>
                            <name>PRIORITY0</name>
                            <description>Priority 0 Setting</description>
                            <lsb>0</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRIORITY1</name>
                            <description>Priority 1 Setting</description>
                            <lsb>3</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRIORITY2</name>
                            <description>Priority 2 Setting</description>
                            <lsb>6</lsb>
                            <msb>8</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRIORITY3</name>
                            <description>Priority 3 Setting</description>
                            <lsb>9</lsb>
                            <msb>11</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRIORITY4</name>
                            <description>Priority 4 Setting</description>
                            <lsb>12</lsb>
                            <msb>14</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRIORITY5</name>
                            <description>Priority 5 Setting</description>
                            <lsb>15</lsb>
                            <msb>17</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRIORITY6</name>
                            <description>Priority 6 Setting</description>
                            <lsb>18</lsb>
                            <msb>20</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>PRIORITY7</name>
                            <description>Priority 7 Setting</description>
                            <lsb>21</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                    </fields>

                <register>
                    <name>MGMT_ADDR0_lo</name>
                    <description>Lower MAC Address 0 for Bridge Protocol Frame Register</description>
                    <addressOffset>0x01C0</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00c28001</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>BPDU_DST</name>
                            <description>Additional MAC address defining a Bridge Protocol Frame (BPDU) in addition to the commonly-known addresses</description>
                            <lsb>0</lsb>
                            <msb>31</msb>
                            <access>read-write</access>

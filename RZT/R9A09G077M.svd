                            <lsb>0</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>00</name>
                                    <description>Not counted (not skipped)</description>
                                    <value>#00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>Counting both at overflow or underflow in sawtooth-wave mode and counting crests in triangle-wave mode</description>
                                    <value>#01</value>
                                </enumeratedValue>

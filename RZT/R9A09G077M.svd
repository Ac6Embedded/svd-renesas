                    <description>Port %s Cut-Through Delay Indication Register</description>
                    <addressOffset>0x858</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000001ff</resetMask>
                    <fields>
                        <field>
                            <name>CT_DELAY</name>
                            <description>Delay Value in 400 ns / 40 ns / 8 ns increments (frequency of the MII PHY interface)</description>
                            <lsb>0</lsb>
                            <msb>8</msb>
                            <access>read-write</access>
                        </field>
                    </fields>

                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Indication for "no special character".</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>A special character was received in the SensorHub Channel.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>PERR</name>
                            <description>Coding error of the bits in the SensorHub Channel</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>

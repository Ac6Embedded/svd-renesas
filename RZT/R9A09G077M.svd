                            <description>When this bit is set to 1, it defines a port as a member of the VLAN. When bit [28] or bit [29] is set, the tagged bit mask is read/written instead of port mask.</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VLANID</name>
                            <description>The 12-bit VLAN identifier (VLAN ID) of the entry.</description>
                            <lsb>4</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RD_TAGMSK</name>
                            <description>Read TAG Mask</description>
                            <lsb>28</lsb>
                            <msb>28</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>The port mask is returned</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The tagged bit mask is returned</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>

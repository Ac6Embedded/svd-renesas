                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>CMD12 is not automatically issued at multiple block transfer.</description>
                                    <value>#01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>10</name>

                                    <name>0</name>
                                    <description>The acknowledgment for the initialization of a DSL Slave message does not set the interrupt signal.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>

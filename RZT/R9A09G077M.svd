                        <field>
                            <name>OCCLRIEN</name>
                            <description>USB_VBUSEN pin control at occurrence of overcurrent</description>
                            <lsb>16</lsb>
                            <msb>16</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>VBOUT bit is not automatically cleared if an overcurrent occurs</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>VBOUT bit is automatically cleared if an overcurrent occurs</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>

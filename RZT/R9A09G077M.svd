                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>WRONGLAN</name>
                            <description>Enable interrupt for frames received at a redundant port with an invalid LAN identifier in its redundancy trailer.</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OUTOFSEQ</name>

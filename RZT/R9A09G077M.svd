                <register>
                    <dim>4</dim>
                    <dimIncrement>0x4</dimIncrement>
                    <dimIndex>0-3</dimIndex>
                    <name>AUTH_PORT%s</name>
                    <description>Port %s Authentication Control and Configuration</description>
                    <addressOffset>0x0240</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00003000</resetValue>
                    <resetMask>0x000ff83e</resetMask>
                    <fields>
                        <field>
                            <name>AUTH</name>
                            <description>Authorized</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>The port is unauthorized restricting forwarding according to the rules configured in this register</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The port is in the authorized state and operates normally without restrictions. The other bits of this register, except for bits [15:12] and bit [2], are not relevant.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>CTRL_BOTH</name>
                            <description>Controlled Both</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>The port operates in Controlled Directions (mode in). This allows frames from other ports to be forwarded to this port for transmission, but reception is still restricted.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The port operates in Controlled Directions (mode both). This means other ports cannot transmit any traffic on this port, except the port specified in the EAPOL destination port.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>EAPOL_EN</name>
                            <description>EAPOL Enable</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>GUEST_EN</name>
                            <description>Guest Enable</description>
                            <lsb>3</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>BPDU_EN</name>

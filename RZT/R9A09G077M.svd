                <register>
                    <dim>2</dim>
                    <dimIncrement>0x100</dimIncrement>
                    <dimIndex>0-1</dimIndex>
                    <name>VI6_RPF%s_LOC</name>
                    <description>RPFn Display Location Register</description>
                    <addressOffset>0x20310</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>VCOORD</name>
                            <description>Vertical Coordinate of Sublayer Display Location on Master Layer</description>
                            <lsb>0</lsb>
                            <msb>12</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>HCOORD</name>
                            <description>Horizontal Coordinate of Sublayer Display Location on Master Layer</description>
                            <lsb>16</lsb>
                            <msb>28</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>2</dim>
                    <dimIncrement>0x100</dimIncrement>
                    <dimIndex>0-1</dimIndex>
                    <name>VI6_RPF%s_ALPH_SEL</name>
                    <description>RPFn alpha Plane Selection Control Register</description>
                    <addressOffset>0x20314</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>ALPHA0</name>
                            <description>8-Bit alpha Value Output when 1-Bit alpha Value is 0</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>ALPHA1</name>
                            <description>8-Bit alpha Value Output when 1-Bit alpha Value is 1</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>AEXT</name>
                            <description>Lower-Bit alpha Value Extension Method Set</description>
                            <lsb>18</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>00</name>
                                    <description>The lower-order bits of alpha value are extended with 0.</description>
                                    <value>#00</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>01</name>
                                    <description>The upper-order bits of alpha value are copied to the lower-order bits.</description>
                                    <value>#01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>10</name>
                                    <description>The lower-order bits of alpha value are extended with 0. The maximum value is limited to 0xFF. </description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>Setting prohibited.</description>
                                    <value>#11</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>BSEL</name>
                            <description>alpha Bit Count Conversion Selection for 1-Bit Mask Generator</description>
                            <lsb>23</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>8-bit alpha is converted to 1-bit alpha through the 1-bit mask generator. When the 8-bit alpha value input to the RPF is not 0, it is converted to 1b; when the value is 0, it is converted to 0b. </description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>alpha value goes through the 1-bit mask generator. The 1-bit alpha value input to the RPF is output through the 1-bit mask generator without change. </description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>IROP</name>
                            <description>IROP Operation Setting</description>
                            <lsb>24</lsb>
                            <msb>27</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0x0</name>
                                    <description>NOP(D)</description>
                                    <value>0x0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x1</name>
                                    <description>AND(S &amp; D)</description>
                                    <value>0x1</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x2</name>
                                    <description>AND_REVERSE(S &amp; ~D)</description>
                                    <value>0x2</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x3</name>
                                    <description>COPY(S)</description>
                                    <value>0x3</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x4</name>
                                    <description>AND_INVERTED(~S &amp; D)</description>
                                    <value>0x4</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x5</name>
                                    <description>CLEAR(0)</description>
                                    <value>0x5</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x6</name>
                                    <description>XOR(S ^ D)</description>
                                    <value>0x6</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x7</name>
                                    <description>OR(S | D)</description>
                                    <value>0x7</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x8</name>
                                    <description>NOR(~(S | D))</description>
                                    <value>0x8</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0x9</name>
                                    <description>EQUIV(~(S ^ D))</description>
                                    <value>0x9</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0xA</name>
                                    <description>INVERT(~D)</description>
                                    <value>0xa</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0xB</name>
                                    <description>OR_REVERSE(S | ~D)</description>
                                    <value>0xb</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0xC</name>
                                    <description>COPY_INVERTED(~S)</description>
                                    <value>0xc</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0xD</name>
                                    <description>OR_INVERTED(~S | D)</description>
                                    <value>0xd</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0xE</name>
                                    <description>NAND(~(S &amp; D))</description>
                                    <value>0xe</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>0xF</name>
                                    <description>SET(all 1)</description>
                                    <value>0xf</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>ASEL</name>
                            <description>alpha Format and Processing Method Select</description>
                            <lsb>28</lsb>
                            <msb>30</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>000</name>
                                    <description>1, 4, or 8-bit packed alpha + plane alpha (IROP != 0, 5, 10, 15) The alpha bit field in 1, 4, or 8-bit packed alpha is handled as transparency information. Be sure to specify the packed format that includes alpha through VI6_RPFn_INFMT.RDFMT. When VI6_RPFn_MSKCTRL.MSK_EN is 0 and the IROP bit value is not 0, 5, 10, or 15, the alpha plane should be read as mask information. Specify the number of alpha data bits (BSEL) stored in the alpha plane and the alpha plane read start address (VI6_RPFn_SRCM_ADDR_AI). When the IROP bits are set to 0, 5, 10, or 15, the alpha plane is not read. </description>
                                    <value>#000</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>001</name>
                                    <description>8-bit plane alpha The 8-bit alpha plane is read from external RAM as transparency information. When the packed RGB format has a bit field for alpha, the information in the alpha bit field is discarded. The alpha plane read start address (VI6_RPFn_SRCM_ADDR_AI) should be specified. The alpha value goes through the 8-bit transparent alpha generator shown in without change. When VI6_RPFn_MSKCTRL.MSK_EN is 0, IROP operation cannot be executed; set the IROP bits to 0 in this case. When VI6_RPFn_MSKCTRL.MSK_EN is 1. IROP operation can be executed. </description>
                                    <value>#001</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>010</name>
                                    <description>1-bit packed alpha + plane alpha (IROP != 0, 5, 10, 15) The 1-bit packed alpha input is converted by the 8-bit transparent alpha generator shown in according to the ALPHA0/1 setting into the 8-bit alpha value as transparency information. Select the packed input format that includes a 1-bit alpha field. When VI6_RPFn_MSKCTRL.MSK_EN is 0 and the IROP value is not 0, 5, 10, or 15, the alpha plane should be read as mask information. Specify the number of alpha data bits (BSEL) stored in the alpha plane and the alpha plane read start address (VI6_RPFn_SRCM_ADDR_AI). When the IROP bits are set to 0, 5, 10, or 15, the alpha plane is not read. </description>
                                    <value>#010</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>011</name>
                                    <description>1-bit plane alpha The 1-bit alpha plane is read from external RAM and converted by the 8-bit transparent alpha generator shown in according to the ALPHA0/1 setting into the 8-bit alpha value as transparency information. When the packed RGB format has a bit field for alpha, the information in the alpha bit field is discarded. The alpha plane read start address (VI6_RPFn_SRCM_ADDR_AI) should be specified. When VI6_RPFn_MSKCTRL.MSK_EN is 0, IROP operation cannot be executed; set the IROP bits to 0 in this case. When VI6_RPFn_MSKCTRL.MSK_EN is 1. IROP operation can be executed. </description>
                                    <value>#011</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>100</name>
                                    <description>Fixed alpha The fixed alpha value (VI6_RPFn_VRTCOL_SET.LAY A value) is output from the RPF. IROP operation cannot be executed; set the IROP bits to 0 in this case. </description>
                                    <value>#100</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>Others</name>
                                    <description>Setting prohibited.</description>
                                    <isDefault>true</isDefault>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>2</dim>
                    <dimIncrement>0x100</dimIncrement>
                    <dimIndex>0-1</dimIndex>
                    <name>VI6_RPF%s_VRTCOL_SET</name>
                    <description>RPFn Virtual Plane Color Information Register</description>
                    <addressOffset>0x20318</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>LAYB</name>
                            <description>Virtual-Input Fixed B/Cb Component Value</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>LAYG</name>
                            <description>Virtual-Input Fixed G/Y Component Value</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>LAYR</name>
                            <description>Virtual-Input Fixed R/Cr Component Value</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>LAYA</name>
                            <description>Virtual-Input Fixed alpha Value</description>
                            <lsb>24</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <dim>2</dim>
                    <dimIncrement>0x100</dimIncrement>
                    <dimIndex>0-1</dimIndex>
                    <name>VI6_RPF%s_MSKCTRL</name>
                    <description>RPFn Mask Control Register</description>
                    <addressOffset>0x2031C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>MGB</name>
                            <description>B/Cb Comparison Value for 1-Bit alpha Generation</description>
                            <lsb>0</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MGG</name>
                            <description>G/Y Comparison Value for 1-Bit alpha Generation</description>
                            <lsb>8</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MGR</name>
                            <description>R/Cr Comparison Value for 1-Bit alpha Generation</description>
                            <lsb>16</lsb>
                            <msb>23</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MSK_EN</name>
                            <description>Mask Generation Specification</description>
                            <lsb>24</lsb>
                            <msb>24</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>A 1-bit mask value is generated according to the input alpha plane value. When the input alpha is in the 1-bit format (VI6_RPFn_ALPH_SEL.BSEL = 1), the 1-bit mask value is output without change. When the input alpha is in the 8-bit format (VI6_RPFn_ALPH_SEL.BSEL = 0), the 1-bit mask value is 0 if the alpha value is 0x00; otherwise, the 1-bit mask value is 1.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The R/Cr, G/Y, and B/Cb components of the image input to the destination side of the IROP operation unit are compared with the values specified in the MGR, MGG, and MGB bits, respectively. When all values match, 1 is output as the 1-bit mask value, and in other cases, 0 is output. When the generated 1-bit mask data is not used, set VI6_RPFn_ALPH_SEL.IROP to 0.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                    </fields>
                </register>

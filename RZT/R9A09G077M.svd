                                    <name>10</name>
                                    <description>4 data bytes</description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>8 data bytes</description>
                                    <value>#11</value>
                                </enumeratedValue>
                            </enumeratedValues>

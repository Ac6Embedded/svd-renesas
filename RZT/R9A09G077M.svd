                <register>
                    <dim>3</dim>
                    <dimIncrement>0x400</dimIncrement>
                    <dimIndex>0-2</dimIndex>
                    <name>BR_CONTROL_P%s</name>
                    <description>Port %s 802.3br Frame Configuration Register</description>
                    <addressOffset>0x85C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000a00</resetValue>
                    <resetMask>0x001f7f37</resetMask>
                    <fields>
                        <field>
                            <name>PREEMPT_ENA</name>
                            <description>When set to 1, enables 802.3br Frame Preemption.</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>VERIFY_DIS</name>
                            <description>When set to 1, disables the verify process required for preemption operation.</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RESPONSE_DIS</name>
                            <description>When set to 1 prevents the MAC from responding to &quot;verify&quot; frames.</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>ADDFRAGSIZE</name>
                            <description>Minimum fragment size in increments of 64 bytes.</description>
                            <lsb>4</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TX_VERIFY_TIME</name>
                            <description>Preemption verification timeout in milliseconds.</description>
                            <lsb>8</lsb>
                            <msb>14</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RX_STRICT_PRE</name>
                            <description>When set to 1, the preamble is checked so all bytes except the SFD are 0x55. When set to 0, only the last 2 bytes of the preamble are checked (SFD/SMD and FRAG_COUNT). It is recommended to set this bit to 1 to comply with the 802.3br specification. This bit must be set to 0 if only non-802.3br traffic is expected (for example, normal Ethernet traffic) and if custom preamble is used.</description>
                            <lsb>16</lsb>
                            <msb>16</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RX_BR_SMD_DIS</name>
                            <description>When set to 1, the receiver does not decode the 802.3br SMDs and assumes all frames are express frames. This bit must be set to 0 for correct operation with 802.3br, and can be set to 1 when 802.3br is not enabled to avoid false detection of SMDs.</description>
                            <lsb>17</lsb>
                            <msb>17</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RX_STRICT_BR_CTL</name>
                            <description>When set to 1, strict checking of VERIFY and RESPONSE frames is enabled. When set to 1, the frame contents and frame length checks are also performed on these frames. The mCRC is always checked regardless of the value of this register. This bit must be set to 0 to be compliant with the functionality described in IEEE 802.3br.</description>
                            <lsb>18</lsb>
                            <msb>18</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>TX_MCRC_INV</name>
                            <description>When set to 1, the 32-bit XOR mask used to calculate the mCRC for transmitted frames is inverted. This bit must always be written to 0 and only used for debugging.</description>
                            <lsb>19</lsb>
                            <msb>19</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>RX_MCRC_INV</name>
                            <description>When set to 1, the 32-bit XOR mask used to calculate the mCRC for received frames is inverted. This bit must always be written to 0 and only used for debugging.</description>
                            <lsb>20</lsb>
                            <msb>20</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>

                <register>
                    <name>VLAN_IN_MODE_ENA</name>
                    <description>VLAN Input Mode Enable Register</description>
                    <addressOffset>0x30</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000000f</resetMask>
                    <fields>
                        <field>
                            <name>VLANINMDEN</name>
                            <description>Enable the input processing according to the VLAN_IN_MODE for a port (1 bit per port).</description>
                            <lsb>0</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>VLAN_TAG_ID</name>
                    <description>VLAN Tag ID Register</description>
                    <addressOffset>0x34</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00008100</resetValue>
                    <resetMask>0x0000ffff</resetMask>
                    <fields>
                        <field>
                            <name>VLANTAGID</name>
                            <description>The VLAN type field (TPID) value to expect to identify a VLAN tagged frame.</description>
                            <lsb>0</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>BCAST_STORM_LIMIT</name>
                    <description>Broadcast Storm Protection Register</description>
                    <addressOffset>0x38</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffffffff</resetMask>
                    <fields>
                        <field>
                            <name>TMOUT</name>
                            <description>Timeout in steps of 65535 switch operating clock cycles.</description>
                            <lsb>0</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>BCASTLIMIT</name>
                            <description>Number of broadcast frames (-1) that can be accepted on a port during a timeout period. If more are received, they are discarded. The counter is implemented per port independently. However, the limit is used for all ports.</description>
                            <lsb>16</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MCAST_STORM_LIMIT</name>
                    <description>Multicast Storm Protection Register</description>
                    <addressOffset>0x3C</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0xffff0000</resetMask>
                    <fields>
                        <field>
                            <name>MCASTLIMIT</name>
                            <description>Number of multicast frames (-1) that can be accepted on a port during a timeout period. If more are received, they are discarded. The counter is implemented per port independently. However, the limit is used for all ports.</description>
                            <lsb>16</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MIRROR_CONTROL</name>
                    <description>Port Mirroring Configuration Register</description>
                    <addressOffset>0x40</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x000007ff</resetMask>
                    <fields>
                        <field>
                            <name>PORT</name>
                            <description>The port number of the port that acts as the mirror port and receives all mirrored frames. Valid setting range is 0 to 3.</description>
                            <lsb>0</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>MIRROR_EN</name>
                            <lsb>4</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>Disabled</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Enabled</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>ING_MAP_EN</name>
                            <description>If set, the ingress map is enabled (MIRROR_ING_MAP).</description>
                            <lsb>5</lsb>
                            <msb>5</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>EG_MAP_EN</name>
                            <description>If set, the egress map is enabled (MIRROR_EG_MAP).</description>
                            <lsb>6</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>ING_SA_MATCH</name>
                            <description>If set, only frames received on an ingress port with a source address matching the value programmed in MIRROR_ISRC registers are mirrored. Other frames are not mirrored.</description>
                            <lsb>7</lsb>
                            <msb>7</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>ING_DA_MATCH</name>
                            <description>If set, only frames received on an ingress port with a destination address matching the value programmed in MIRROR_IDST registers are mirrored. Other frames are not mirrored.</description>
                            <lsb>8</lsb>
                            <msb>8</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>EG_SA_MATCH</name>
                            <description>If set, only frames transmitted on an egress port with a source address matching the value programmed in MIRROR_ESRC registers are mirrored. Other frames are not mirrored.</description>
                            <lsb>9</lsb>
                            <msb>9</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>EG_DA_MATCH</name>
                            <description>If set, only frames transmitted on an egress port with a destination address matching the value programmed in MIRROR_EDST registers are mirrored. Other frames are not mirrored.</description>
                            <lsb>10</lsb>
                            <msb>10</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>

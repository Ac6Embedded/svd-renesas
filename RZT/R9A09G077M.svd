                            <lsb>0</lsb>
                            <msb>0</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>WRONGLAN</name>
                            <description>This bit functions the same as MEMTOOLATE bit.</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>OUTOFSEQ</name>
                            <description>This bit functions the same as MEMTOOLATE bit.</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>SEQMISSING</name>
                            <description>This bit functions the same as MEMTOOLATE bit.</description>
                            <lsb>3</lsb>
                            <msb>3</msb>
                            <access>read-write</access>
                        </field>
                    </fields>

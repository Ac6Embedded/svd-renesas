                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>DMA transfer is disabled (the EN bit in the CHSTAT_n register is cleared)</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>

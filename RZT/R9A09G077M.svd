                <register>
                    <name>MIRROR_IDST_1</name>
                    <description>Ingress Destination MAC Address for Mirror Filtering Register 1</description>
                    <addressOffset>0x58</addressOffset>
                    <size>32</size>
                    <access>read-write</access>
                    <resetValue>0x00000000</resetValue>
                    <resetMask>0x0000ffff</resetMask>
                    <fields>
                        <field>
                            <name>IDST</name>
                            <description>Ingress Destination MAC Address for Mirror Filtering</description>
                            <lsb>0</lsb>
                            <msb>15</msb>
                            <access>read-write</access>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>MIRROR_ESRC_0</name>

                            <name>ENABLE</name>
                            <description>Write to 1 to enable the Link Queue Trigger feature. When the link status (phy_link) transitions from 1 -&gt; 0, a trigger event is generated to the memory controller for the ports and queues indicated in PORT_MASK and QUEUE_MASK.</description>
                            <lsb>31</lsb>
                            <msb>31</msb>
                            <access>read-write</access>
                        </field>

                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>If a "long message" can be sent on the Parameters Channel, the interrupt signal is set.</description>
                                    <value>#1</value>
                                </enumeratedValue>

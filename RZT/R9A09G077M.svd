                                <enumeratedValue>
                                    <name>10</name>
                                    <description>1 Gbps</description>
                                    <value>#10</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>11</name>
                                    <description>Reserved</description>
                                    <value>#11</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>
                        <field>
                            <name>PHYLINK</name>
                            <description>Link status from PHY interface</description>
